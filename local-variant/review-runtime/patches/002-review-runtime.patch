+def _kanban_evidence_remaining() -> float | None:
+    """Return seconds left in the active review/evidence window."""
+    raw = os.environ.get("HERMES_KANBAN_EVIDENCE_DEADLINE", "").strip()
+    if not raw:
+        return None
+    try:
+        deadline = float(raw)
+    except (TypeError, ValueError):
+        # A malformed boundary is fail-closed: this worker must not turn an
+        # invalid deadline into an unbounded evidence session.
+        return 0.0
+    return deadline - time.time()
+
