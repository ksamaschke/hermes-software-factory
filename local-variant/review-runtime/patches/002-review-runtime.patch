+def _kanban_tool_timeout_cap() -> int | None:
+    """Read the dispatcher-selected per-command cap, if this is a worker."""
+    raw = os.environ.get("HERMES_KANBAN_TOOL_TIMEOUT_SECONDS", "").strip()
+    if not raw:
+        return None
