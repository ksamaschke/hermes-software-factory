+class ReviewIncompleteError(ValueError):
+    """Raised when a review/evidence run cannot produce an honest approval."""
+
+    code = REVIEW_INCOMPLETE_CODE
+
+    def __init__(self, task_id: str, reason: str):
+        self.task_id = task_id
+        self.reason = reason
+        super().__init__(f"{self.code}: {reason}; task {task_id} is blocked")
+
+
+def _review_handoff_has_evidence(
+    summary: Optional[str], result: Optional[str], metadata: Optional[dict]
+) -> bool:
+    """Return whether a review completion carries a non-empty handoff."""
+    if isinstance(summary, str) and summary.strip():
+        return True
+    if isinstance(result, str) and result.strip():
+        return True
+    return isinstance(metadata, dict) and bool(metadata)
+
+
+def _claimed_runtime_details(
+    conn: sqlite3.Connection,
+    task_id: str,
+    run_id: Optional[int],
+) -> tuple[str, Optional[int], Optional[int], Optional[str]]:
+    """Return ``(class, evidence_budget, started_at, outcome)`` for a run."""
+    task_row = conn.execute(
+        "SELECT runtime_class FROM tasks WHERE id = ?", (task_id,)
+    ).fetchone()
+    runtime_class = (
+        str(task_row["runtime_class"]).strip().lower()
+        if task_row and task_row["runtime_class"]
+        else RUNTIME_CLASS_IMPLEMENTATION
+    )
+    started_at: Optional[int] = None
+    outcome: Optional[str] = None
+    evidence_budget: Optional[int] = None
+    if run_id is None:
+        return runtime_class, evidence_budget, started_at, outcome
+    run_row = conn.execute(
+        "SELECT started_at, outcome FROM task_runs WHERE id = ? AND task_id = ?",
+        (int(run_id), task_id),
+    ).fetchone()
+    if run_row:
+        started_at = int(run_row["started_at"]) if run_row["started_at"] is not None else None
+        outcome = str(run_row["outcome"]) if run_row["outcome"] else None
+    claimed = conn.execute(
+        "SELECT payload FROM task_events "
+        "WHERE task_id = ? AND run_id = ? AND kind = 'claimed' "
+        "ORDER BY id DESC LIMIT 1",
+        (task_id, int(run_id)),
+    ).fetchone()
+    try:
+        payload = json.loads(claimed["payload"]) if claimed and claimed["payload"] else {}
+    except (json.JSONDecodeError, TypeError):
+        payload = {}
+    if isinstance(payload, dict):
+        selected = payload.get("runtime_class") or payload.get("runtime_policy")
+        if selected:
+            runtime_class = str(selected).strip().lower()
+        raw_budget = payload.get("evidence_budget_seconds")
+        try:
+            evidence_budget = int(raw_budget) if raw_budget is not None else None
+        except (TypeError, ValueError):
+            evidence_budget = None
+    if evidence_budget is None and runtime_class in VALID_RUNTIME_CLASSES:
+        evidence_budget = resolve_runtime_policy(runtime_class).evidence_budget_seconds
+    return runtime_class, evidence_budget, started_at, outcome
+
+
+def _claimed_evidence_deadline(
+    conn: sqlite3.Connection,
+    task_id: str,
+    run_id: Optional[int],
+) -> Optional[float]:
+    """Read the exact deadline stamped on the active claimed event."""
+    if run_id is None:
+        return None
+    row = conn.execute(
+        "SELECT payload FROM task_events "
+        "WHERE task_id = ? AND run_id = ? AND kind = 'claimed' "
+        "ORDER BY id DESC LIMIT 1",
+        (task_id, int(run_id)),
+    ).fetchone()
+    try:
+        payload = json.loads(row["payload"]) if row and row["payload"] else {}
+        value = payload.get("evidence_deadline") if isinstance(payload, dict) else None
+        return float(value) if value is not None else None
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return None
+
+
+def _review_completion_rejection(
+    conn: sqlite3.Connection,
+    task_id: str,
+    *,
+    expected_run_id: Optional[int],
+    summary: Optional[str],
+    result: Optional[str],
+    metadata: Optional[dict],
+) -> Optional[str]:
+    """Return a typed rejection reason for an unsafe review completion."""
+    task_row = conn.execute(
+        "SELECT status, current_run_id, runtime_class FROM tasks WHERE id = ?",
+        (task_id,),
+    ).fetchone()
+    if task_row is None:
+        return None
+    current_run_id = task_row["current_run_id"]
+    if expected_run_id is not None:
+        if current_run_id is None or int(current_run_id) != int(expected_run_id):
+            # The CAS in complete_task owns this race. Never block a successor
+            # run when an older worker has lost ownership.
+            return None
+        run_id = int(expected_run_id)
+    else:
+        run_id = int(current_run_id) if current_run_id is not None else None
+
+    runtime_class, evidence_budget, started_at, outcome = _claimed_runtime_details(
+        conn, task_id, run_id
+    )
+    review_like = (
+        task_row["status"] == "review"
+        or runtime_class in {
+            RUNTIME_CLASS_REVIEW,
+            RUNTIME_CLASS_EVIDENCE_RECOVERY,
+        }
+    )
+    if not review_like:
+        return None
+
+    # A task left in review after a timed-out/crashed attempt must be claimed
+    # again before it can be approved. Otherwise a human/CLI close would turn a
+    # failed review into a synthetic approval without a fresh evidence window.
+    if run_id is None and task_row["status"] == "review":
+        latest = conn.execute(
+            "SELECT outcome FROM task_runs WHERE task_id = ? "
+            "ORDER BY id DESC LIMIT 1",
+            (task_id,),
+        ).fetchone()
+        latest_outcome = str(latest["outcome"]) if latest and latest["outcome"] else None
+        if latest_outcome in _REVIEW_FAILURE_OUTCOMES:
+            return (
+                f"the prior review run ended with {latest_outcome}; "
+                "claim a fresh review run before approving"
+            )
+
+    if outcome in _REVIEW_FAILURE_OUTCOMES:
+        return (
+            f"review run already ended with {outcome}; "
+            "a completed review cannot be approved from a failed run"
+        )
+
+    evidence_deadline = _claimed_evidence_deadline(conn, task_id, run_id)
+    if evidence_deadline is not None:
+        elapsed = max(0, int(time.time() - (evidence_deadline - int(evidence_budget or 0))))
+        if time.time() >= evidence_deadline:
+            return (
+                f"evidence budget expired after {int(evidence_budget or 0)}s "
+                f"(elapsed {elapsed}s); no further probes or approval are allowed"
+            )
+    elif evidence_budget is not None and started_at is not None:
+        elapsed = time.time() - int(started_at)
+        if elapsed >= int(evidence_budget):
+            return (
+                f"evidence budget expired after {int(evidence_budget)}s "
+                f"(elapsed {int(elapsed)}s); no further probes or approval are allowed"
+            )
+
+    if not _review_handoff_has_evidence(summary, result, metadata):
+        return "review approval requires a non-empty summary, result, or metadata handoff"
+    return None
+
