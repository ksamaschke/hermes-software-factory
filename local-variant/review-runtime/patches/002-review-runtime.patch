+def resolve_runtime_policy(
+    runtime_class: Optional[str] = None,
+    *,
+    source_status: Optional[str] = None,
+) -> RuntimePolicy:
+    """Resolve a canonical class without inspecting task prose.
+
+    A review source phase is authoritative for review claims. Otherwise an
+    explicit entrypoint/class wins, falling back to implementation for legacy
+    rows. Invalid durable values fail closed rather than silently receiving a
+    more permissive implementation budget.
+    """
+    if source_status == "review":
+        selected = RUNTIME_CLASS_REVIEW
+    else:
+        selected = str(runtime_class or RUNTIME_CLASS_IMPLEMENTATION).strip().lower()
+    try:
+        return _RUNTIME_POLICIES[selected]
+    except KeyError as exc:
+        raise ValueError(
+            f"unknown kanban runtime class: {selected!r}; "
+            f"expected one of {sorted(VALID_RUNTIME_CLASSES)}"
+        ) from exc
+
+
+def _dispatch_runtime_class(
+    explicit: Optional[str],
+    *,
+    assignee: Optional[str],
+    stored: Optional[str],
+) -> str:
+    """Resolve ready-lane policy without trusting reviewer prose.
+
+    Review cards can be requeued to ``ready`` after changes are requested and
+    legacy rows may still carry the implementation default. The canonical
+    reviewer profile therefore receives review limits in the ready lane too;
+    an explicit recovery/dispatch class remains authoritative.
+    """
+    if explicit:
+        return explicit
+    if str(assignee or "").strip().lower() in {"review", "reviewer"}:
+        return RUNTIME_CLASS_REVIEW
+    return str(stored or RUNTIME_CLASS_IMPLEMENTATION).strip().lower()
+
+
+def _effective_runtime_seconds(
+    requested: Optional[int], policy: RuntimePolicy
+) -> Optional[int]:
+    try:
+        value = int(requested) if requested is not None else 0
+    except (TypeError, ValueError):
+        value = 0
+    requested_value = value if value > 0 else None
+    if policy.hard_cap_seconds is None:
+        return requested_value
+    if requested_value is None:
+        return policy.hard_cap_seconds
+    return min(requested_value, policy.hard_cap_seconds)
+
+
+def _apply_runtime_policy_to_task(task: Task, policy: RuntimePolicy) -> None:
+    task.runtime_class = policy.runtime_class
+    task.evidence_budget_seconds = policy.evidence_budget_seconds
+    task.command_timeout_seconds = policy.command_timeout_seconds
+
+
+def _bounded_worker_timeout_env(
+    current_timeout: Optional[str], cap_seconds: int
+) -> str:
+    """Keep an inherited worker timeout at or below the policy cap."""
+    try:
+        existing = int(str(current_timeout).strip()) if current_timeout else 0
+    except (TypeError, ValueError):
+        existing = 0
+    if existing > 0:
+        return str(min(existing, int(cap_seconds)))
+    return str(int(cap_seconds))
+
+
+def _review_dispatch_runtime_seconds(max_runtime_seconds: Optional[int]) -> int:
+    """Backward-compatible review cap helper for callers/tests."""
+    result = _effective_runtime_seconds(max_runtime_seconds, REVIEW_RUNTIME_POLICY)
+    assert result is not None
+    return result
 
 
