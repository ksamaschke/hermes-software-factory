+def _review_worker_env(
+    env: Mapping[str, str],
+    *,
+    runtime_root: Path,
+    hermes_argv: Optional[Iterable[str]] = None,
+) -> dict[str, str]:
+    """Return the small, explicit environment allowed for a Kanban worker.
+
+    A dispatcher is a long-lived process and can carry credentials, routing
+    ContextVars, Python startup hooks, and a caller-controlled PATH from an
+    unrelated conversation.  A worker must receive only the values needed to
+    run Hermes and its assigned task.  Provider credential names are admitted
+    from the central environment policy; arbitrary ``*_TOKEN``/``*_SECRET``
+    values are not.
+    """
+    safe_names = {
+        "HOME", "USER", "LOGNAME", "SHELL", "LANG", "LANGUAGE", "LC_ALL",
+        "LC_CTYPE", "TZ", "TERM", "COLORTERM", "TERM_PROGRAM", "CI",
+        "NO_COLOR", "FORCE_COLOR", "TMP", "TEMP", "TMPDIR", "SYSTEMROOT",
+        "WINDIR", "DISPLAY", "WAYLAND_DISPLAY", "DBUS_SESSION_BUS_ADDRESS",
+        "GIT_CONFIG_NOSYSTEM", "GIT_TERMINAL_PROMPT", "GH_HOST", "GH_REPO",
+        "GIT_AUTHOR_NAME", "GIT_AUTHOR_EMAIL", "GIT_COMMITTER_NAME",
+        "GIT_COMMITTER_EMAIL", "PAGER", "LESS", "EDITOR", "VISUAL",
+    }
+    safe_prefixes = ("LC_", "XDG_")
+    provider_names: set[str] = set()
+    try:
+        from tools.environments.local import _HERMES_PROVIDER_ENV_BLOCKLIST
+
+        provider_names.update(str(key) for key in _HERMES_PROVIDER_ENV_BLOCKLIST)
+    except Exception:
+        # The worker can still start with profile-configured credentials when
+        # the optional environment policy module is unavailable.
+        pass
+    # A few provider variables are intentionally listed here as a fallback for
+    # older staged runtimes whose blocklist predates a provider integration.
+    provider_names.update({
+        "OPENAI_API_KEY", "OPENAI_BASE_URL", "ANTHROPIC_API_KEY",
+        "ANTHROPIC_BASE_URL", "OPENROUTER_API_KEY", "GEMINI_API_KEY",
+        "GOOGLE_API_KEY", "GROQ_API_KEY", "MISTRAL_API_KEY", "XAI_API_KEY",
+        "DEEPSEEK_API_KEY", "COHERE_API_KEY", "TOGETHER_API_KEY",
+        "AZURE_OPENAI_API_KEY", "AZURE_OPENAI_ENDPOINT", "AWS_ACCESS_KEY_ID",
+        "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN", "AWS_REGION",
+    })
+    # These are explicitly forbidden even if a provider policy accidentally
+    # includes a similarly named internal or gateway credential.
+    forbidden = {
+        "HERMES_BIN", "PYTHONPATH", "PYTHONHOME", "PYTHONSTARTUP",
+        "PYTHONBREAKPOINT", "PYTHONINSPECT", "PYTHONUSERBASE", "PYTHONWARNINGS",
+        "PYTHONNOUSERSITE", "PYTHONSAFEPATH", "PYTHONUTF8", "PATH",
+        "GH_TOKEN", "GITHUB_TOKEN", "TELEGRAM_BOT_TOKEN", "DISCORD_BOT_TOKEN",
+        "SLACK_BOT_TOKEN", "SLACK_APP_TOKEN", "SLACK_SIGNING_SECRET",
+        "GATEWAY_ALLOWED_USERS", "GATEWAY_ALLOW_ALL_USERS", "HERMES_TUI",
+    }
+    child: dict[str, str] = {}
+    for raw_key, raw_value in env.items():
+        key = str(raw_key)
+        if key in forbidden or key.startswith("HERMES_SESSION_"):
+            continue
+        if key in safe_names or key in provider_names or key.startswith(safe_prefixes):
+            child[key] = str(raw_value)
+    child["PATH"] = _review_worker_path(runtime_root, hermes_argv)
+    # These flags disable user-site and startup-file injection.  They are set
+    # after the allowlist so an inherited value cannot turn the guard off.
+    child["PYTHONNOUSERSITE"] = "1"
+    child["PYTHONSAFEPATH"] = "1"
+    child["PYTHONUTF8"] = "1"
+    return child
+
+
+def _review_worker_path(runtime_root: Path, hermes_argv: Optional[Iterable[str]] = None) -> str:
+    """Build a deterministic PATH for a detached worker child."""
+    candidates: list[Path] = []
+    if hermes_argv:
+        first = str(next(iter(hermes_argv), ""))
+        if first and os.path.isabs(first) and os.path.isfile(first):
+            candidates.append(Path(first).parent)
+    if sys.executable:
+        candidates.append(Path(sys.executable).resolve().parent)
+    candidates.extend([
+        runtime_root / "bin",
+        Path("/usr/local/bin"),
+        Path("/usr/bin"),
+        Path("/bin"),
+    ])
+    unique: list[str] = []
+    for candidate in candidates:
+        try:
+            value = str(candidate.resolve())
+        except OSError:
+            value = str(candidate)
+        if value not in unique and os.path.isdir(value):
+            unique.append(value)
+    return os.pathsep.join(unique)
