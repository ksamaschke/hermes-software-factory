+    if predecessor_run_id <= 0:
+        raise ValueError("expected_predecessor_run_id must be positive")
+    successor_run_id = None
+    if expected_successor_run_id is not None:
+        try:
+            successor_run_id = int(expected_successor_run_id)
+        except (TypeError, ValueError) as exc:
+            raise ValueError("expected_successor_run_id must be an integer") from exc
+        if successor_run_id <= 0:
