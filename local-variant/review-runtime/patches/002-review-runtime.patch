diff --git a/tools/evidence_window.py b/tools/evidence_window.py
new file mode 100644
index 0000000000000000000000000000000000000000..84e477ff4de780d085c20a121f25d32b1564fc2f
--- /dev/null
+++ b/tools/evidence_window.py
@@ -0,0 +1,213 @@
+"""Import-neutral evidence-window guards for bounded runtime work.
+
+This module deliberately has no dependency on terminal_tool.  Backend
+implementations and tools can use it without importing the interactive
+terminal module (which depends on those same backends).
+"""
+
+from __future__ import annotations
+
+import json
+import math
+import os
+import time
+from typing import Any, Callable
+
+BOUNDED_RUNTIME_CLASSES = frozenset({"review", "evidence_recovery"})
+EXECUTION_PHASES = frozenset({"work", "observe", "settle", "cleanup"})
+
+
+class ReviewEvidenceDeadlineExpired(RuntimeError):
+    """Signal that bounded evidence work may no longer be started."""
+
+
+def _runtime_class() -> str:
+    return os.environ.get("HERMES_KANBAN_RUNTIME_CLASS", "").strip().lower()
+
+
+def evidence_window_expected(*, require_evidence_window: bool = False) -> bool:
+    """Return whether this process is expected to carry a durable window."""
+    if require_evidence_window or _runtime_class() in BOUNDED_RUNTIME_CLASSES:
+        return True
+    return any(
+        os.environ.get(name, "").strip()
+        for name in (
+            "HERMES_KANBAN_EVIDENCE_STARTED_AT",
+            "HERMES_KANBAN_EVIDENCE_BUDGET_SECONDS",
+            "HERMES_KANBAN_EVIDENCE_DEADLINE",
+        )
+    )
+
+
+def kanban_tool_timeout_cap() -> int | None:
+    """Return the positive per-command cap for a bounded worker."""
+    runtime_class = _runtime_class()
+    if not evidence_window_expected():
+        return None
+    # Any partial evidence tuple means a bounded window was expected.  An
+    # absent or malformed runtime class must therefore get the strictest
+    # bounded fallback rather than an unbounded cleanup/readback path.
+    class_cap = {"review": 120, "evidence_recovery": 60}.get(runtime_class, 60)
+    raw = os.environ.get("HERMES_KANBAN_TOOL_TIMEOUT_SECONDS", "").strip()
+    if class_cap is not None:
+        if raw:
+            try:
+                configured = int(raw)
+            except (TypeError, ValueError, OverflowError):
+                return class_cap
+            if configured > 0:
+                return min(configured, class_cap)
+        return class_cap
+    if raw:
+        try:
+            configured = int(raw)
+        except (TypeError, ValueError, OverflowError):
+            return None
+        if configured > 0:
+            return configured
+    return None
+
+
+def kanban_evidence_remaining(
+    *,
+    now: float | None = None,
+    time_fn: Callable[[], float] | None = None,
+) -> float | None:
+    """Return seconds left in the authenticated evidence window.
+
+    ``None`` means no deadline was supplied and is only acceptable outside a
+    bounded worker.  Invalid persisted tuples return ``0.0`` so callers fail
+    closed without manufacturing a replacement deadline.
+    """
+    raw_deadline = os.environ.get("HERMES_KANBAN_EVIDENCE_DEADLINE", "").strip()
+    if not raw_deadline:
+        return None
+    raw_started_at = os.environ.get(
+        "HERMES_KANBAN_EVIDENCE_STARTED_AT", ""
+    ).strip()
+    raw_budget = os.environ.get(
+        "HERMES_KANBAN_EVIDENCE_BUDGET_SECONDS", ""
+    ).strip()
+    try:
+        deadline = float(raw_deadline)
+        started_at = float(raw_started_at)
+        budget = int(raw_budget)
+    except (TypeError, ValueError, OverflowError):
+        return 0.0
+    if not (
+        math.isfinite(deadline)
+        and math.isfinite(started_at)
+        and budget > 0
+        and float(budget) <= deadline - started_at <= float(budget) + 2.0
+    ):
+        return 0.0
+    current_fn = time.time if time_fn is None else time_fn
+    current = current_fn() if now is None else now
+    try:
+        current_value = float(current)
+    except (TypeError, ValueError, OverflowError):
+        return 0.0
+    if not math.isfinite(current_value):
+        return 0.0
+    return deadline - current_value
+
+
+def evidence_execute_timeout(
+    requested_timeout: float | int | None = None,
+    *,
+    require_evidence_window: bool = False,
+    phase: str = "work",
+) -> float | None:
+    """Return one bounded timeout or reject unsafe bounded work.
+
+    ``work`` is the default and is the only phase allowed to launch user
+    work.  ``observe``/``settle``/``cleanup`` are explicit, bounded operations
+    on work that has already started; they remain available after expiry so a
+    caller can collect a result or terminate the owned process, but they never
+    turn a missing deadline into permission to launch new work.
+    """
+    if phase not in EXECUTION_PHASES:
+        raise ValueError(f"unknown evidence execution phase: {phase!r}")
+
+    expected = evidence_window_expected(
+        require_evidence_window=require_evidence_window
+    )
+    remaining = kanban_evidence_remaining()
+    bounded_work = phase == "work"
+    if remaining is None and expected and bounded_work:
+        raise ReviewEvidenceDeadlineExpired(
+            "evidence window is missing; no further probes or approval are allowed"
+        )
+
+    cap = kanban_tool_timeout_cap()
+    if requested_timeout is None:
+        effective = float(cap) if cap is not None else None
+    else:
+        try:
+            effective = float(requested_timeout)
+        except (TypeError, ValueError, OverflowError) as exc:
+            if expected and bounded_work:
+                raise ReviewEvidenceDeadlineExpired(
+                    "command timeout is malformed"
+                ) from exc
+            raise
+        if not math.isfinite(effective) or effective <= 0:
+            if expected and bounded_work:
+                raise ReviewEvidenceDeadlineExpired(
+                    "command timeout must be positive"
+                )
+            return None
+
+    if cap is not None and effective is not None:
+        effective = min(effective, float(cap))
+
+    if remaining is None:
+        return effective
+    if remaining <= 0:
+        if bounded_work:
+            raise ReviewEvidenceDeadlineExpired(
+                "evidence budget expired; no further probes or approval are allowed"
+            )
+        # Cleanup/readback is still allowed, but it remains bounded by the
+        # caller's positive timeout and the worker cap.
+        return effective
+    if effective is None:
+        return remaining
+    return min(effective, remaining)
+
+
+def execute_with_evidence_window(
+    env: Any,
+    command: str,
+    *,
+    timeout: float | int | None = None,
+    phase: str = "work",
+    require_evidence_window: bool = False,
+    **kwargs: Any,
+) -> Any:
+    """Execute one backend command through the shared phase guard."""
+    bounded_timeout = evidence_execute_timeout(
+        timeout,
+        require_evidence_window=require_evidence_window,
+        phase=phase,
+    )
+    if bounded_timeout is not None:
+        kwargs["timeout"] = bounded_timeout
+    elif timeout is not None:
+        kwargs["timeout"] = timeout
+    kwargs["evidence_phase"] = phase
+    return env.execute(command, **kwargs)
+
+
+def review_incomplete_response(reason: str) -> str:
+    """Return the typed response used when bounded evidence cannot continue."""
+    return json.dumps(
+        {
+            "output": "",
+            "exit_code": -1,
+            "error": f"REVIEW-INCOMPLETE: {reason}",
+            "code": "REVIEW-INCOMPLETE",
+            "status": "blocked",
+        },
+        ensure_ascii=False,
+    )
