+def _explicit_timeout_run_id(event: Any) -> Optional[int]:
+    """Return the run id carried by an event or its legacy payload."""
+    value = getattr(event, "run_id", None)
+    if value is None:
+        payload = getattr(event, "payload", None)
+        if isinstance(payload, dict):
+            value = payload.get("current_run_id")
