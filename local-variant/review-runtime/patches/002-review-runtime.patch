+def _handle_supersede(args: dict, **kw) -> str:
+    """Replace one terminal failed card with one fenced canonical successor."""
+    delegated_err = _reject_delegated_child_mutation("kanban_supersede")
+    if delegated_err:
+        return delegated_err
+    guard = _require_orchestrator_tool("kanban_supersede")
+    if guard:
+        return guard
+    predecessor_id = args.get("predecessor_id")
+    successor_id = args.get("successor_id")
+    lane_key = args.get("lane_key")
+    predecessor_run_id = args.get("expected_predecessor_run_id")
+    if not predecessor_id or not successor_id or not lane_key:
+        return tool_error(
+            "predecessor_id, successor_id, and lane_key are required"
+        )
+    if predecessor_run_id is None:
+        return tool_error("expected_predecessor_run_id is required")
+    evidence = args.get("evidence")
+    if not isinstance(evidence, dict) or not evidence:
+        return tool_error("non-empty structured evidence is required")
+    board = args.get("board")
+    try:
+        kb, conn = _connect(board=board)
+        try:
+            relation = kb.supersede_task(
+                conn,
+                str(predecessor_id),
+                str(successor_id),
+                lane_key=str(lane_key),
+                expected_predecessor_run_id=int(predecessor_run_id),
+                expected_successor_run_id=(
+                    int(args["expected_successor_run_id"])
+                    if args.get("expected_successor_run_id") is not None
+                    else None
+                ),
+                reason=str(args.get("reason") or ""),
+                evidence=evidence,
+            )
+            return _ok(**relation)
+        finally:
+            conn.close()
+    except (TypeError, ValueError, RuntimeError) as e:
+        return tool_error(f"kanban_supersede: {e}")
+    except Exception as e:
+        logger.exception("kanban_supersede failed")
+        return tool_error(f"kanban_supersede: {e}")
+
