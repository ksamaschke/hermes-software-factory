+@dataclass(frozen=True)
+class RuntimePolicy:
+    """Boundaries applied to one dispatcher-owned worker attempt."""
+
+    runtime_class: str
+    hard_cap_seconds: Optional[int]
+    evidence_budget_seconds: Optional[int]
+    command_timeout_seconds: Optional[int]
+
+
+IMPLEMENTATION_RUNTIME_POLICY = RuntimePolicy(
+    RUNTIME_CLASS_IMPLEMENTATION, None, None, None
+)
+REVIEW_RUNTIME_POLICY = RuntimePolicy(
+    RUNTIME_CLASS_REVIEW, REVIEW_DISPATCH_HARD_CAP_SECONDS, 600, 120
+)
+EVIDENCE_RECOVERY_RUNTIME_POLICY = RuntimePolicy(
+    RUNTIME_CLASS_EVIDENCE_RECOVERY, 600, 300, 60
+)
+_RUNTIME_POLICIES = {
+    policy.runtime_class: policy
+    for policy in (
+        IMPLEMENTATION_RUNTIME_POLICY,
+        REVIEW_RUNTIME_POLICY,
+        EVIDENCE_RECOVERY_RUNTIME_POLICY,
+    )
+}
