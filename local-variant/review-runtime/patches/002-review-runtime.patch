+def _timeout_event_run_id(
+    events: list[Any], index: int, event: Any
+) -> Optional[int]:
+    """Associate a legacy unbound ``gave_up`` with its preceding timeout.
+
+    Older ``_record_task_failure(end_run=False)`` rows omitted ``run_id`` and
+    ``current_run_id`` from the gave-up event. Terminal events are returned in
+    event-id order, so the nearest preceding identified timeout is the only
+    recoverable attempt boundary. A later identified timeout naturally starts a
+    new boundary and prevents an older unbound gave-up from suppressing it.
+    """
+    explicit = _explicit_timeout_run_id(event)
+    if explicit is not None or getattr(event, "kind", "") != "gave_up":
+        return explicit
+    for prior in reversed(events[:index]):
+        if getattr(prior, "kind", "") != "timed_out":
+            continue
+        prior_run_id = _explicit_timeout_run_id(prior)
+        if prior_run_id is not None:
+            return prior_run_id
+    return None
+
+
+def _latest_timeout_run_events(events: list[Any]) -> list[Any]:
+    """Select one attempt and its final timeout decision.
+
+    A subscription cursor may return history from several attempts at once.
+    Timeout wording must not let an older terminal attempt suppress a later
+    retryable attempt. Legacy NULL-run gave-up rows are associated with the
+    nearest preceding identified timeout by event order. If the selected
+    attempt is exhausted, the final ``gave_up`` decision replaces its earlier
+    timeout notice so consumers cannot render both terminal and retry wording.
+    """
+    resolved: list[tuple[Any, Optional[int]]] = []
+    for index, event in enumerate(events):
+        if getattr(event, "kind", "") not in {"timed_out", "gave_up"}:
+            continue
+        resolved.append((event, _timeout_event_run_id(events, index, event)))
+    if not resolved:
+        return []
+    identified = [run_id for _, run_id in resolved if run_id is not None]
+    if not identified:
+        latest_events = [event for event, _ in resolved]
+    else:
+        latest_run_id = max(identified)
+        latest_events = [
+            event for event, run_id in resolved if run_id == latest_run_id
+        ]
+    if any(event.kind == "gave_up" for event in latest_events):
+        return [event for event in latest_events if event.kind == "gave_up"]
+    return latest_events
+
+
+def _reduce_timeout_notifications(events: list[Any]) -> list[Any]:
+    """Keep unrelated events while reducing timeout history to one decision."""
+    timeout_kinds = {"timed_out", "gave_up"}
+    if not any(getattr(event, "kind", "") in timeout_kinds for event in events):
+        return list(events)
+    selected_ids = {
+        id(event) for event in _latest_timeout_run_events(events)
+    }
+    return [
+        event
+        for event in events
+        if getattr(event, "kind", "") not in timeout_kinds
+        or id(event) in selected_ids
+    ]
 
 
