+def canonical_task_chain(
+    conn: sqlite3.Connection, task_id: str
+) -> tuple[str, ...]:
+    """Return the immutable predecessor-to-leaf supersession chain.
+
+    One predecessor and one successor may appear only once in the relation, so
+    a chain has one canonical leaf. A cycle indicates database corruption and
+    fails closed instead of guessing which card owns delivery.
+    """
+    chain: list[str] = []
+    seen: set[str] = set()
+    current = str(task_id)
+    while True:
+        if current in seen:
+            raise RuntimeError(
+                f"canonical recovery cycle detected while resolving {task_id}"
+            )
+        seen.add(current)
+        chain.append(current)
+        row = conn.execute(
+            "SELECT successor_id FROM task_supersessions "
+            "WHERE predecessor_id = ?",
+            (current,),
+        ).fetchone()
+        if row is None:
+            return tuple(chain)
+        current = str(row["successor_id"])
+
+
+def canonical_task_id(conn: sqlite3.Connection, task_id: str) -> str:
+    """Resolve ``task_id`` to the sole current recovery leaf."""
+    return canonical_task_chain(conn, task_id)[-1]
+

