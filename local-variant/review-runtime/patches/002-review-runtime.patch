+def _settle_timed_out_run(
+    conn: sqlite3.Connection,
+    *,
+    task_id: str,
+    pid: int,
+    claim_lock: str,
+    expected_run_id: Optional[int],
+    elapsed: int,
+    limit_seconds: int,
+    killed: bool,
+    failure_limit: Optional[int],
+) -> bool:
+    """Atomically settle one fenced timeout attempt.
+
+    The claim, run pointer, failure counter, and terminal events are one
+    transaction. A task/run generation mismatch means another dispatcher has
+    already taken ownership, so the old timeout is discarded without touching
+    the newer attempt.
+    """
+    if expected_run_id is None:
+        return False
+    timeout_error = f"elapsed {int(elapsed)}s > limit {int(limit_seconds)}s"
+    with write_txn(conn):
+        current = conn.execute(
+            "SELECT status, worker_pid, claim_lock, current_run_id, "
+            "consecutive_failures, max_retries "
+            "FROM tasks WHERE id = ?",
+            (task_id,),
+        ).fetchone()
+        if (
+            current is None
+            or current["status"] != "running"
+            or current["worker_pid"] != pid
+            or current["claim_lock"] != claim_lock
+            or current["current_run_id"] != int(expected_run_id)
+        ):
+            return False
+
+        retry_status = _retry_status_for_run(conn, task_id, expected_run_id)
+        failures = int(current["consecutive_failures"] or 0) + 1
+        effective_limit = (
+            int(current["max_retries"])
+            if current["max_retries"] is not None
+            else (
+                int(failure_limit)
+                if failure_limit is not None
+                else DEFAULT_FAILURE_LIMIT
+            )
+        )
+        gave_up = failures >= effective_limit
+        final_status = "blocked" if gave_up else retry_status
+        payload = {
+            "pid": pid,
+            "elapsed_seconds": int(elapsed),
+            "limit_seconds": int(limit_seconds),
+            "sigkill": killed,
+            "retry_status": final_status,
+            "final_status": final_status,
+            "retry_eligible": not gave_up,
+            "current_run_id": int(expected_run_id),
+        }
+        settled_at = int(time.time())
+        run_cur = conn.execute(
+            "UPDATE task_runs SET status = 'timed_out', outcome = 'timed_out', "
+            "error = ?, metadata = ?, ended_at = ?, claim_lock = NULL, "
+            "claim_expires = NULL, worker_pid = NULL "
+            "WHERE id = ? AND task_id = ? AND ended_at IS NULL "
+            "AND claim_lock IS ?",
+            (
+                timeout_error,
+                json.dumps(payload, ensure_ascii=False),
+                settled_at,
+                int(expected_run_id),
+                task_id,
+                claim_lock,
+            ),
+        )
+        if run_cur.rowcount != 1:
+            return False
+        task_cur = conn.execute(
+            "UPDATE tasks SET status = ?, claim_lock = NULL, "
+            "claim_expires = NULL, worker_pid = NULL, "
+            "last_heartbeat_at = NULL, current_run_id = NULL, "
+            "consecutive_failures = ?, last_failure_error = ? "
+            "WHERE id = ? AND status = 'running' AND worker_pid = ? "
+            "AND claim_lock IS ? AND current_run_id = ?",
+            (
+                final_status,
+                failures,
+                timeout_error[:500],
+                task_id,
+                pid,
+                claim_lock,
+                int(expected_run_id),
+            ),
+        )
+        if task_cur.rowcount != 1:
+            raise RuntimeError("timeout settlement lost its run claim")
+        _append_event(conn, task_id, "timed_out", payload, run_id=expected_run_id)
+        if gave_up:
+            _append_event(
+                conn,
+                task_id,
+                "gave_up",
+                {
+                    "failures": failures,
+                    "effective_limit": effective_limit,
+                    "limit_source": (
+                        "task" if current["max_retries"] is not None else "dispatcher"
+                    ),
+                    "error": timeout_error[:500],
+                    "trigger_outcome": "timed_out",
+                    "retry_status": "blocked",
+                    "final_status": "blocked",
+                    "retry_eligible": False,
+                    "current_run_id": int(expected_run_id),
+                    "pid": pid,
+                    "sigkill": killed,
+                },
+                run_id=expected_run_id,
+            )
+    return True
+
