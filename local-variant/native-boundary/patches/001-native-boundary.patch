+def _repository_from_remote_url(value: str) -> Optional[str]:
+    remote = str(value or "").strip()
+    if not remote or any(char in remote for char in ("\n", "\r", "\x00")):
+        return None
+    without_query = remote.split("?", 1)[0].split("#", 1)[0].rstrip("/")
+    if without_query.endswith(".git"):
+        without_query = without_query[:-4]
+    if "://" in without_query:
+        path = without_query.split("://", 1)[1].split("/", 1)
+        if len(path) != 2:
+            return None
+        repo_path = path[1]
+    elif ":" in without_query and "@" in without_query.split(":", 1)[0]:
+        repo_path = without_query.split(":", 1)[1]
+    else:
+        repo_path = without_query
+    parts = [part for part in repo_path.split("/") if part]
+    if len(parts) < 2:
+        return None
+    repository = "/".join(parts[-2:])
+    return repository if re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository) else None
+
