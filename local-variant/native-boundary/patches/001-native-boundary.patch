+def _review_body_field(body: str, name: str) -> Optional[str]:
+    """Return one unambiguous scalar review-packet field."""
+    matches = re.findall(
+        rf"(?m)^[ \t]*{re.escape(name)}[ \t]*:[ \t]*(.*?)[ \t]*$",
+        str(body or ""),
+    )
+    if len(matches) != 1:
+        return None
+    value = matches[0].strip().strip("`")
+    return value or None
+
+
+def _review_packet(body: str) -> tuple[Optional[dict[str, str]], Optional[str]]:
+    required = (
+        "review_type",
+        "implementation_task",
+        "target_repository",
+        "target_worktree",
+        "branch",
+        "base_commit",
+        "candidate_commit",
+        "scope_manifest_sha256",
+        "implementer_profile",
+        "reviewer_profile",
+        "read_only_source",
+        "review_kind",
+        "review_scope",
+    )
+    packet: dict[str, str] = {}
+    for field_name in required:
+        value = _review_body_field(body, field_name)
+        if value is None:
+            return None, f"missing or ambiguous review packet field: {field_name}"
+        packet[field_name] = value
+    if packet["review_type"] != "read-only adversarial code review leaf":
+        return None, "review_type is not the exact standalone review contract"
+    if packet["read_only_source"] != "true":
+        return None, "read_only_source must be true"
+    if packet["review_kind"] not in {"pre_commit", "pre_merge", "exact_head"}:
+        return None, "review_kind is not supported"
+    if packet["review_scope"] != "change_set":
+        return None, "review_scope must be change_set"
+    if re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", packet["target_repository"]) is None:
+        return None, "target_repository is not canonical owner/repository"
+    if (
+        not packet["branch"]
+        or packet["branch"].startswith(("/", "."))
+        or ".." in packet["branch"]
+        or re.fullmatch(r"[A-Za-z0-9._/-]+", packet["branch"]) is None
+    ):
+        return None, "branch is not canonical"
+    for commit_field in ("base_commit", "candidate_commit"):
+        commit = packet[commit_field].casefold()
+        if not _REVIEW_COMMIT_RE.fullmatch(commit):
+            return None, f"{commit_field} is not a canonical 40-hex commit"
+        packet[commit_field] = commit
+    scope_digest = packet["scope_manifest_sha256"].casefold()
+    if re.fullmatch(r"[0-9a-f]{64}", scope_digest) is None:
+        return None, "scope_manifest_sha256 is not a canonical SHA-256"
+    packet["scope_manifest_sha256"] = scope_digest
+    try:
+        packet["implementer_profile"] = _canonical_assignee(
+            packet["implementer_profile"]
+        ) or ""
+        packet["reviewer_profile"] = _canonical_assignee(
+            packet["reviewer_profile"]
+        ) or ""
+    except Exception:
+        return None, "review packet profile is not canonicalizable"
+    if not packet["implementer_profile"] or not packet["reviewer_profile"]:
+        return None, "review packet profile is empty"
+    if packet["implementer_profile"] == packet["reviewer_profile"]:
+        return None, "implementer and reviewer profiles must be distinct"
+    if not re.fullmatch(r"t_[A-Za-z0-9_]+", packet["implementation_task"]):
+        return None, "implementation_task is malformed"
+    return packet, None
+
+
+def _review_claim_payload(
+    conn: sqlite3.Connection, task_id: str, run_id: int
+) -> tuple[Optional[dict[str, Any]], Optional[str]]:
+    rows = conn.execute(
+        "SELECT payload FROM task_events "
+        "WHERE task_id = ? AND run_id = ? AND kind = 'claimed' ORDER BY id",
+        (task_id, run_id),
+    ).fetchall()
+    if len(rows) != 1 or not rows[0]["payload"]:
+        return None, "review run does not have exactly one claimed event"
+    payload = _strict_json_object(rows[0]["payload"])
+    if payload is None:
+        return None, "review claimed event is malformed"
+    keys = frozenset(payload)
+    ready_keys = frozenset({"lock", "expires", "run_id"})
+    review_keys = frozenset({"lock", "expires", "run_id", "source_status"})
+    if keys not in {ready_keys, review_keys}:
+        return None, "review claimed event has an invalid schema"
+    if (
+        type(payload.get("lock")) is not str
+        or not payload["lock"].strip()
+        or type(payload.get("expires")) is not int
+        or payload["expires"] <= 0
+        or _exact_positive_run_id(payload.get("run_id")) != run_id
+    ):
+        return None, "review claimed event has invalid typed fields"
+    if keys == review_keys and payload.get("source_status") != "review":
+        return None, "review claimed event has an invalid source_status"
+    payload["source_status"] = "review" if keys == review_keys else "ready"
+    return payload, None
+
