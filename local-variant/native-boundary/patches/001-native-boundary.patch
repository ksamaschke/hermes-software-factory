+def _review_workspace_identity(
+    packet: Mapping[str, str],
+) -> tuple[Optional[dict[str, Any]], Optional[str]]:
+    raw_workspace = Path(packet["target_worktree"]).expanduser()
+    try:
+        if raw_workspace.is_symlink():
+            return None, "target_worktree must not be a symlink"
+        workspace = raw_workspace.resolve(strict=True)
+        workspace_stat = workspace.stat()
+    except (OSError, RuntimeError):
+        return None, "target_worktree is not a stable directory"
+    if not workspace.is_dir():
+        return None, "target_worktree is not a directory"
+
+    def git_text(*arguments: str) -> Optional[str]:
+        try:
+            probe = subprocess.run(
+                ["/usr/bin/git", "-C", str(workspace), *arguments],
+                env={"PATH": "/usr/bin:/bin", "HOME": str(Path.home())},
+                text=True,
+                capture_output=True,
+                check=False,
+                timeout=15,
+            )
+        except (OSError, subprocess.TimeoutExpired):
+            return None
+        return probe.stdout.strip() if probe.returncode == 0 else None
+
+    root_text = git_text("rev-parse", "--show-toplevel")
+    git_dir_text = git_text("rev-parse", "--git-dir")
+    origin_url = git_text("config", "--get", "remote.origin.url")
+    head = git_text("rev-parse", "--verify", "HEAD^{commit}")
+    branch = git_text("symbolic-ref", "--quiet", "--short", "HEAD")
+    base = git_text("rev-parse", "--verify", f"{packet['base_commit']}^{{commit}}")
+    candidate = git_text("rev-parse", "--verify", f"{packet['candidate_commit']}^{{commit}}")
+    if not all((root_text, git_dir_text, origin_url, head, branch, base, candidate)):
+        return None, "review worktree Git provenance is incomplete"
+    try:
+        cleanliness = subprocess.run(
+            [
+                "/usr/bin/git",
+                "-C",
+                str(workspace),
+                "status",
+                "--porcelain=v1",
+                "-z",
+                "--untracked-files=all",
+            ],
+            env={"PATH": "/usr/bin:/bin", "HOME": str(Path.home())},
+            capture_output=True,
+            check=False,
+            timeout=15,
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        return None, "review worktree cleanliness could not be established"
+    if cleanliness.returncode != 0 or cleanliness.stdout:
+        return None, "review worktree is not clean at candidate_commit"
+    try:
+        root = Path(root_text).resolve(strict=True)
+        git_dir_candidate = Path(git_dir_text)
+        git_dir = (
+            git_dir_candidate
+            if git_dir_candidate.is_absolute()
+            else workspace / git_dir_candidate
+        ).resolve(strict=True)
+        git_dir_stat = git_dir.stat()
+    except (OSError, RuntimeError):
+        return None, "review worktree Git paths are unstable"
+    if root != workspace:
+        return None, "target_worktree is not the repository root"
+    if _repository_from_remote_url(origin_url) != packet["target_repository"]:
+        return None, "target_repository does not match origin"
+    if branch != packet["branch"]:
+        return None, "review branch does not match the checked out branch"
+    if head.casefold() != packet["candidate_commit"] or candidate.casefold() != packet["candidate_commit"]:
+        return None, "workspace HEAD does not match candidate_commit"
+    if base.casefold() != packet["base_commit"]:
+        return None, "base_commit is not present in the review repository"
+    try:
+        scope_probe = subprocess.run(
+            [
+                "/usr/bin/git",
+                "-C",
+                str(workspace),
+                "diff",
+                "--name-only",
+                "--no-renames",
+                "-z",
+                packet["base_commit"],
+                packet["candidate_commit"],
+            ],
+            env={"PATH": "/usr/bin:/bin", "HOME": str(Path.home())},
+            capture_output=True,
+            check=False,
+            timeout=15,
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        return None, "review scope could not be read"
+    if scope_probe.returncode != 0:
+        return None, "review scope could not be read"
+    paths = sorted(path for path in scope_probe.stdout.split(b"\x00") if path)
+    scope_bytes = b"\x00".join(paths) + (b"\x00" if paths else b"")
+    if hashlib.sha256(scope_bytes).hexdigest() != packet["scope_manifest_sha256"]:
+        return None, "review scope manifest does not match the candidate diff"
+    return {
+        "contract_version": REVIEW_REMEDIATION_CONTRACT_VERSION,
+        "repository": packet["target_repository"],
+        "branch": packet["branch"],
+        "base_commit": packet["base_commit"],
+        "candidate_commit": packet["candidate_commit"],
+        "scope_manifest_sha256": packet["scope_manifest_sha256"],
+        "workspace_realpath": str(workspace),
+        "workspace_device": int(workspace_stat.st_dev),
+        "workspace_inode": int(workspace_stat.st_ino),
+        "git_dir_realpath": str(git_dir),
+        "git_dir_device": int(git_dir_stat.st_dev),
+        "git_dir_inode": int(git_dir_stat.st_ino),
+    }, None
+
