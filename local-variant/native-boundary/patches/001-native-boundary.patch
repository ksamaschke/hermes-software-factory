+def consume_standalone_review_handoffs(
+    conn: sqlite3.Connection,
+    *,
+    actor: str,
+    limit: int = 16,
+) -> list[dict[str, Any]]:
+    """Consume pending review-rejection receipts under native SQLite fencing.
+
+    Only the configured coordinator profile may call this entry point. Each
+    handoff is validated, created/reused, reparented, archived, and marked
+    applied in one ``BEGIN IMMEDIATE`` transaction. A retry after an ambiguous
+    caller result reads the same applied receipt and never creates a duplicate.
+    """
+    canonical_actor = _canonical_assignee(actor)
+    if not canonical_actor:
+        raise PermissionError("standalone review remediation requires an active coordinator profile")
+    bounded_limit = max(1, min(int(limit), 100))
+    keys = [
+        str(row["handoff_key"])
+        for row in conn.execute(
+            "SELECT handoff_key FROM review_remediation_handoffs "
+            "WHERE status = 'pending' AND coordinator_profile = ? "
+            "ORDER BY created_at, handoff_key LIMIT ?",
+            (canonical_actor, bounded_limit),
+        ).fetchall()
+    ]
+    results: list[dict[str, Any]] = []
+    for handoff_key in keys:
+        with write_txn(conn):
+            handoff = conn.execute(
+                "SELECT * FROM review_remediation_handoffs WHERE handoff_key = ?",
+                (handoff_key,),
+            ).fetchone()
+            if handoff is None:
+                continue
+            if handoff["coordinator_profile"] != canonical_actor:
+                raise PermissionError(f"handoff {handoff_key} belongs to another coordinator")
+            if handoff["status"] == "applied":
+                successor = _existing_handoff_successor(conn, handoff_key)
+                if successor is None or successor["id"] != handoff["successor_task_id"]:
+                    raise RuntimeError(f"applied handoff {handoff_key} lost its successor")
+                results.append(
+                    {"handoff_key": handoff_key, "successor_task_id": successor["id"], "reused": True}
+                )
+                continue
+            leaf = conn.execute(
+                "SELECT * FROM tasks WHERE id = ?",
+                (handoff["leaf_task_id"],),
+            ).fetchone()
+            if leaf is None or leaf["status"] != "blocked" or leaf["current_run_id"] is not None:
+                raise RuntimeError(f"handoff {handoff_key} leaf is no longer terminally blocked")
+            packet, packet_error = _review_packet(str(leaf["body"] or ""))
+            if packet_error is not None or packet is None:
+                raise RuntimeError(f"handoff {handoff_key} packet changed: {packet_error}")
+            receipt_error = _review_packet_claim_receipt(
+                conn, str(leaf["id"]), int(handoff["review_run_id"]), packet
+            )
+            if receipt_error is not None:
+                raise RuntimeError(f"handoff {handoff_key} packet receipt changed: {receipt_error}")
+            packet_sha = _review_sha256(_review_json(packet))
+            graph = _review_graph_snapshot(conn, str(leaf["id"]))
+            graph_json = _review_json(graph)
+            if (
+                packet_sha != handoff["packet_sha256"]
+                or _review_sha256(graph_json) != handoff["frontier_sha256"]
+                or graph_json != handoff["frontier_json"]
+                or packet["candidate_commit"] != handoff["candidate_commit"]
+                or packet["reviewer_profile"] != handoff["reviewer_profile"]
+                or packet["implementer_profile"] != handoff["implementer_profile"]
+                or packet["implementation_task"] != handoff["implementation_task"]
+                or _canonical_assignee(str(leaf["created_by"] or "")) != handoff["coordinator_profile"]
+                or _review_sha256(str(handoff["reason"])) != handoff["finding_sha256"]
+            ):
+                raise RuntimeError(f"handoff {handoff_key} provenance or frontier changed")
+            run = conn.execute(
+                "SELECT * FROM task_runs WHERE id = ? AND task_id = ?",
+                (handoff["review_run_id"], leaf["id"]),
+            ).fetchone()
+            newest = conn.execute(
+                "SELECT id FROM task_runs WHERE task_id = ? ORDER BY id DESC LIMIT 1",
+                (leaf["id"],),
+            ).fetchone()
+            event = conn.execute(
+                "SELECT payload FROM task_events WHERE task_id = ? AND run_id = ? "
+                "AND kind = 'standalone_review_changes_requested' ORDER BY id DESC LIMIT 1",
+                (leaf["id"], handoff["review_run_id"]),
+            ).fetchone()
+            try:
+                event_payload = json.loads(event["payload"]) if event and event["payload"] else {}
+            except (json.JSONDecodeError, TypeError):
+                event_payload = {}
+            if (
+                run is None
+                or newest is None
+                or int(newest["id"]) != int(handoff["review_run_id"])
+                or run["status"] != "blocked"
+                or run["outcome"] != "changes_requested"
+                or run["ended_at"] is None
+                or _canonical_assignee(str(run["profile"] or "")) != handoff["reviewer_profile"]
+                or not isinstance(event_payload, dict)
+                or event_payload.get("handoff_key") != handoff_key
+                or event_payload.get("frontier_sha256") != handoff["frontier_sha256"]
+            ):
+                raise RuntimeError(f"handoff {handoff_key} terminal review receipt is invalid")
+            if _review_workspace_head(packet["target_worktree"]) != handoff["candidate_commit"]:
+                raise RuntimeError(f"handoff {handoff_key} candidate is no longer current")
+
+            successor = _existing_handoff_successor(conn, handoff_key)
+            reused = successor is not None
+            if successor is None:
+                successor_body = _handoff_successor_body(
+                    leaf=leaf, handoff=handoff, packet=packet
+                )
+                successor_id = create_task(
+                    conn,
+                    title=f"Remediate review findings: {leaf['title']}",
+                    body=successor_body,
+                    assignee=handoff["implementer_profile"],
+                    created_by=canonical_actor,
+                    workspace_kind="dir",
+                    workspace_path=packet["target_worktree"],
+                    tenant=leaf["tenant"],
+                    priority=int(leaf["priority"] or 0),
+                    parents=(handoff["implementation_task"],),
+                    idempotency_key=handoff_key,
+                    initial_status="running",
+                )
+                successor = conn.execute(
+                    "SELECT * FROM tasks WHERE id = ?",
+                    (successor_id,),
+                ).fetchone()
+            if (
+                successor is None
+                or successor["status"] == "archived"
+                or successor["idempotency_key"] != handoff_key
+                or successor["assignee"] != handoff["implementer_profile"]
+                or _review_body_field(str(successor["body"] or ""), "review_remediation_handoff_key") != handoff_key
+                or _review_body_field(str(successor["body"] or ""), "review_required_before_completion") != "true"
+            ):
+                raise RuntimeError(f"handoff {handoff_key} successor identity readback failed")
+            successor_id = str(successor["id"])
+
+            for child in graph["children"]:
+                deleted = conn.execute(
+                    "DELETE FROM task_links WHERE parent_id = ? AND child_id = ?",
+                    (leaf["id"], child["id"]),
+                )
+                if deleted.rowcount != 1:
+                    raise RuntimeError(f"handoff {handoff_key} lost frontier edge {child['id']}")
+                conn.execute(
+                    "INSERT INTO task_links (parent_id, child_id) VALUES (?, ?)",
+                    (successor_id, child["id"]),
+                )
+                _append_event(
+                    conn,
+                    child["id"],
+                    "reparented",
+                    {
+                        "from_parent": leaf["id"],
+                        "to_parent": successor_id,
+                        "reason": "standalone_review_remediation",
+                        "handoff_key": handoff_key,
+                    },
+                )
+            archived = conn.execute(
+                "UPDATE tasks SET status = 'archived', completed_at = ?, "
+                "claim_lock = NULL, claim_expires = NULL, worker_pid = NULL "
+                "WHERE id = ? AND status = 'blocked' AND current_run_id IS NULL",
+                (int(time.time()), leaf["id"]),
+            )
+            if archived.rowcount != 1:
+                raise RuntimeError(f"handoff {handoff_key} could not archive its leaf")
+            now = int(time.time())
+            applied = conn.execute(
+                "UPDATE review_remediation_handoffs SET status = 'applied', "
+                "successor_task_id = ?, consumed_at = ? "
+                "WHERE handoff_key = ? AND status = 'pending'",
+                (successor_id, now, handoff_key),
+            )
+            if applied.rowcount != 1:
+                raise RuntimeError(f"handoff {handoff_key} lost its pending receipt")
+            _inherit_notify_subs(conn, successor_id, (str(leaf["id"]),))
+            _append_event(
+                conn,
+                str(leaf["id"]),
+                "standalone_review_handoff_consumed",
+                {
+                    "handoff_key": handoff_key,
+                    "successor_task_id": successor_id,
+                    "reparented_child_ids": [child["id"] for child in graph["children"]],
+                    "coordinator": canonical_actor,
+                },
+                run_id=int(handoff["review_run_id"]),
+            )
+            _append_event(
+                conn,
+                successor_id,
+                "review_remediation_created",
+                {
+                    "handoff_key": handoff_key,
+                    "standalone_review_leaf": leaf["id"],
+                    "review_run_id": int(handoff["review_run_id"]),
+                    "candidate_commit": handoff["candidate_commit"],
+                },
+            )
+            for child in graph["children"]:
+                actual_parents = {
+                    str(row["parent_id"])
+                    for row in conn.execute(
+                        "SELECT parent_id FROM task_links WHERE child_id = ?",
+                        (child["id"],),
+                    ).fetchall()
+                }
+                expected_parents = set(child["parent_ids"])
+                expected_parents.remove(str(leaf["id"]))
+                expected_parents.add(successor_id)
+                if actual_parents != expected_parents:
+                    raise RuntimeError(f"handoff {handoff_key} frontier readback failed")
+            readback = conn.execute(
+                "SELECT status, successor_task_id FROM review_remediation_handoffs "
+                "WHERE handoff_key = ?",
+                (handoff_key,),
+            ).fetchone()
+            leaf_status = conn.execute(
+                "SELECT status FROM tasks WHERE id = ?", (leaf["id"],)
+            ).fetchone()
+            if (
+                readback is None
+                or readback["status"] != "applied"
+                or readback["successor_task_id"] != successor_id
+                or leaf_status is None
+                or leaf_status["status"] != "archived"
+            ):
+                raise RuntimeError(f"handoff {handoff_key} terminal readback failed")
+            results.append(
+                {"handoff_key": handoff_key, "successor_task_id": successor_id, "reused": reused}
+            )
+    return results
+
