+def _existing_handoff_successor(
+    conn: sqlite3.Connection, handoff_key: str
+) -> Optional[sqlite3.Row]:
+    rows = conn.execute(
+        "SELECT * FROM tasks WHERE idempotency_key = ? ORDER BY created_at, id",
+        (handoff_key,),
+    ).fetchall()
+    if len(rows) > 1:
+        raise RuntimeError(f"multiple remediation tasks share {handoff_key}")
+    return rows[0] if rows else None
+
