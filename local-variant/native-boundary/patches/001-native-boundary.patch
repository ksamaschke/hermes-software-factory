+def _review_completion_rejection(
+    conn: sqlite3.Connection,
+    task_id: str,
+    *,
+    metadata: Optional[dict],
+    expected_run_id: Optional[int],
+) -> Optional[str]:
+    task = conn.execute(
+        "SELECT body, assignee, created_by, workspace_path, status, current_run_id FROM tasks WHERE id = ?",
+        (task_id,),
+    ).fetchone()
+    if task is None:
+        return None
+    body = str(task["body"] or "")
+    packet, packet_error = _review_packet(body)
+    review_required = _review_body_field(body, "review_required_before_completion") == "true"
+    standalone_declared = _review_body_field(body, "review_type") is not None
+    standalone_registered = conn.execute(
+        "SELECT 1 FROM task_events WHERE task_id = ? "
+        "AND kind = 'standalone_review_packet_claimed' LIMIT 1",
+        (task_id,),
+    ).fetchone() is not None
+    is_standalone = packet_error is None and packet is not None
+    if not review_required and not is_standalone and not standalone_declared and not standalone_registered:
+        return None
+    if (standalone_declared or standalone_registered) and not is_standalone:
+        return packet_error or "standalone review packet is invalid"
+    if task["status"] != "running" or task["current_run_id"] is None:
+        return "review-gated task has no active reviewer run"
+    run_id = int(task["current_run_id"])
+    if expected_run_id is not None and run_id != int(expected_run_id):
+        return "review run_id mismatch"
+    claim, claim_error = _review_claim_payload(conn, task_id, run_id)
+    if claim_error is not None or claim is None:
+        return claim_error or "review claim is missing"
+    run = conn.execute(
+        "SELECT profile, status, outcome, ended_at FROM task_runs WHERE id = ? AND task_id = ?",
+        (run_id, task_id),
+    ).fetchone()
+    newest = conn.execute(
+        "SELECT id FROM task_runs WHERE task_id = ? ORDER BY id DESC LIMIT 1",
+        (task_id,),
+    ).fetchone()
+    if (
+        run is None
+        or run["status"] != "running"
+        or run["outcome"] is not None
+        or run["ended_at"] is not None
+        or newest is None
+        or int(newest["id"]) != run_id
+    ):
+        return "review run is not current and active"
+    if not isinstance(metadata, dict):
+        return "structured review completion metadata is required"
+    verdict = str(
+        metadata.get("review_outcome") or metadata.get("overall_verdict") or metadata.get("verdict") or ""
+    ).strip().upper().replace("-", "_").replace(" ", "_")
+    if verdict != "APPROVED":
+        return "only exact APPROVED evidence may complete a review-gated task"
+    candidate = str(metadata.get("candidate_commit") or "").strip().casefold()
+    if not _REVIEW_COMMIT_RE.fullmatch(candidate):
+        return "review approval has no canonical candidate_commit"
+
+    source_status = claim.get("source_status") or "ready"
+    expected_reviewer: Optional[str] = None
+    expected_candidate: Optional[str] = None
+    if is_standalone and packet is not None:
+        if source_status != "ready":
+            return "standalone review was not claimed from ready"
+        receipt_error = _review_packet_claim_receipt(conn, task_id, run_id, packet)
+        if receipt_error is not None:
+            return receipt_error
+        expected_reviewer = packet["reviewer_profile"]
+        expected_candidate = packet["candidate_commit"]
+        creator = _canonical_assignee(str(task["created_by"] or ""))
+        if not creator or creator == expected_reviewer:
+            return "standalone review leaf has no independent creator provenance"
+        if str(task["workspace_path"] or "") != packet["target_worktree"]:
+            return "standalone review workspace changed"
+        graph = _review_graph_snapshot(conn, task_id)
+        parent = next(
+            (row for row in graph["parents"] if row["id"] == packet["implementation_task"]),
+            None,
+        )
+        if parent is None or parent["status"] != "done":
+            return "implementation task is not a completed direct parent"
+        if any(
+            child["status"] != "todo"
+            or child["started_at"] is not None
+            or child["current_run_id"] is not None
+            for child in graph["children"]
+        ):
+            return "downstream frontier is not untouched and gated"
+    elif review_required:
+        if source_status != "review":
+            return "remediation completion requires a same-card review claim"
+        requested = conn.execute(
+            "SELECT run_id, payload FROM task_events WHERE task_id = ? "
+            "AND kind = 'review_requested' ORDER BY id DESC LIMIT 1",
+            (task_id,),
+        ).fetchone()
+        if requested is None or requested["run_id"] is None:
+            return "same-card review has no native review_requested receipt"
+        try:
+            requested_payload = json.loads(requested["payload"]) if requested["payload"] else {}
+        except (json.JSONDecodeError, TypeError):
+            requested_payload = {}
+        if not isinstance(requested_payload, dict):
+            return "review_requested receipt is malformed"
+        expected_reviewer = _canonical_assignee(str(requested_payload.get("reviewer") or ""))
+        implementation_run = conn.execute(
+            "SELECT status, outcome, metadata, ended_at FROM task_runs WHERE id = ? AND task_id = ?",
+            (int(requested["run_id"]), task_id),
+        ).fetchone()
+        if (
+            implementation_run is None
+            or implementation_run["status"] != "review"
+            or implementation_run["outcome"] != "review_requested"
+            or implementation_run["ended_at"] is None
+        ):
+            return "review_requested implementation run is not terminal"
+        try:
+            implementation_metadata = (
+                json.loads(implementation_run["metadata"])
+                if implementation_run["metadata"]
+                else {}
+            )
+        except (json.JSONDecodeError, TypeError):
+            implementation_metadata = {}
+        if not isinstance(implementation_metadata, dict):
+            return "review_requested metadata is malformed"
+        expected_candidate = str(implementation_metadata.get("candidate_commit") or "").strip().casefold()
+        if not _REVIEW_COMMIT_RE.fullmatch(expected_candidate):
+            return "review_requested metadata has no canonical candidate_commit"
+    reviewer = _canonical_assignee(str(run["profile"] or ""))
+    assignee = _canonical_assignee(str(task["assignee"] or ""))
+    if not expected_reviewer or reviewer != expected_reviewer or assignee != reviewer:
+        return "reviewer identity does not match native handoff provenance"
+    if candidate != expected_candidate:
+        return "approved candidate_commit does not match the native review handoff"
+    if _review_workspace_head(str(task["workspace_path"] or "")) != candidate:
+        return "workspace HEAD does not match the approved candidate_commit"
+    return None
+
