+_STANDALONE_REVIEW_CHANGES_PREFIX = "STANDALONE_REVIEW_CHANGES_REQUESTED:"
+_REVIEW_COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
+
+
+def _review_sha256(value: str) -> str:
+    return hashlib.sha256(value.encode("utf-8")).hexdigest()
+
+
+def _review_json(value: Any) -> str:
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+
+def _review_body_field(body: str, name: str) -> Optional[str]:
+    """Return one unambiguous scalar review-packet field."""
+    matches = re.findall(
+        rf"(?m)^[ \t]*{re.escape(name)}[ \t]*:[ \t]*(.*?)[ \t]*$",
+        str(body or ""),
+    )
+    if len(matches) != 1:
+        return None
+    value = matches[0].strip().strip("`")
+    return value or None
+
+
+def _review_packet(body: str) -> tuple[Optional[dict[str, str]], Optional[str]]:
+    required = (
+        "review_type",
+        "implementation_task",
+        "target_repository",
+        "target_worktree",
+        "candidate_commit",
+        "implementer_profile",
+        "reviewer_profile",
+        "read_only_source",
+        "review_kind",
+        "review_scope",
+    )
+    packet: dict[str, str] = {}
+    for field_name in required:
+        value = _review_body_field(body, field_name)
+        if value is None:
+            return None, f"missing or ambiguous review packet field: {field_name}"
+        packet[field_name] = value
+    if "review leaf" not in packet["review_type"].casefold():
+        return None, "review_type is not a standalone review leaf"
+    if packet["read_only_source"].casefold() != "true":
+        return None, "read_only_source must be true"
+    candidate = packet["candidate_commit"].casefold()
+    if not _REVIEW_COMMIT_RE.fullmatch(candidate):
+        return None, "candidate_commit is not a canonical 40-hex commit"
+    packet["candidate_commit"] = candidate
+    try:
+        packet["implementer_profile"] = _canonical_assignee(
+            packet["implementer_profile"]
+        ) or ""
+        packet["reviewer_profile"] = _canonical_assignee(
+            packet["reviewer_profile"]
+        ) or ""
+    except Exception:
+        return None, "review packet profile is not canonicalizable"
+    if not packet["implementer_profile"] or not packet["reviewer_profile"]:
+        return None, "review packet profile is empty"
+    if not re.fullmatch(r"t_[A-Za-z0-9_]+", packet["implementation_task"]):
+        return None, "implementation_task is malformed"
+    return packet, None
+
+
+def _review_claim_payload(
+    conn: sqlite3.Connection, task_id: str, run_id: int
+) -> tuple[Optional[dict[str, Any]], Optional[str]]:
+    rows = conn.execute(
+        "SELECT payload FROM task_events "
+        "WHERE task_id = ? AND run_id = ? AND kind = 'claimed' ORDER BY id",
+        (task_id, int(run_id)),
+    ).fetchall()
+    if len(rows) != 1 or not rows[0]["payload"]:
+        return None, "review run does not have exactly one claimed event"
+    try:
+        payload = json.loads(rows[0]["payload"])
+    except (json.JSONDecodeError, TypeError):
+        return None, "review claimed event is malformed"
+    if not isinstance(payload, dict):
+        return None, "review claimed event is not an object"
+    return payload, None
+
+
+def _review_packet_claim_receipt(
+    conn: sqlite3.Connection,
+    task_id: str,
+    run_id: int,
+    packet: Mapping[str, str],
+) -> Optional[str]:
+    rows = conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND run_id = ? "
+        "AND kind = 'standalone_review_packet_claimed' ORDER BY id",
+        (task_id, int(run_id)),
+    ).fetchall()
+    if len(rows) != 1 or not rows[0]["payload"]:
+        return "standalone review run has no unique packet claim receipt"
+    try:
+        payload = json.loads(rows[0]["payload"])
+    except (json.JSONDecodeError, TypeError):
+        return "standalone review packet claim receipt is malformed"
+    expected_sha = _review_sha256(_review_json(dict(packet)))
+    if (
+        not isinstance(payload, dict)
+        or payload.get("source_status") != "ready"
+        or payload.get("packet_sha256") != expected_sha
+        or payload.get("candidate_commit") != packet["candidate_commit"]
+        or payload.get("reviewer_profile") != packet["reviewer_profile"]
+    ):
+        return "standalone review packet changed after claim"
+    return None
+
+
+def _review_graph_snapshot(conn: sqlite3.Connection, leaf_task_id: str) -> dict[str, Any]:
+    parents = [
+        {"id": row["id"], "status": row["status"]}
+        for row in conn.execute(
+            "SELECT t.id, t.status FROM task_links l "
+            "JOIN tasks t ON t.id = l.parent_id "
+            "WHERE l.child_id = ? ORDER BY t.id",
+            (leaf_task_id,),
+        ).fetchall()
+    ]
+    children: list[dict[str, Any]] = []
+    child_rows = conn.execute(
+        "SELECT t.id, t.status, t.started_at, t.current_run_id "
+        "FROM task_links l JOIN tasks t ON t.id = l.child_id "
+        "WHERE l.parent_id = ? ORDER BY t.id",
+        (leaf_task_id,),
+    ).fetchall()
+    for child in child_rows:
+        child_id = str(child["id"])
+        parent_ids = [
+            str(row["parent_id"])
+            for row in conn.execute(
+                "SELECT parent_id FROM task_links WHERE child_id = ? ORDER BY parent_id",
+                (child_id,),
+            ).fetchall()
+        ]
+        children.append(
+            {
+                "id": child_id,
+                "status": child["status"],
+                "started_at": child["started_at"],
+                "current_run_id": child["current_run_id"],
+                "parent_ids": parent_ids,
+            }
+        )
+    return {"parents": parents, "children": children}
+
+
+def _review_workspace_head(workspace_path: str) -> Optional[str]:
+    try:
+        workspace = Path(workspace_path).expanduser().resolve(strict=True)
+    except (OSError, RuntimeError):
+        return None
+    git = Path("/usr/bin/git")
+    if not workspace.is_dir() or not git.is_file():
+        return None
+    try:
+        probe = subprocess.run(
+            [str(git), "-C", str(workspace), "rev-parse", "--verify", "HEAD^{commit}"],
+            env={"PATH": "/usr/bin:/bin", "HOME": str(Path.home())},
+            text=True,
+            capture_output=True,
+            timeout=5,
+            check=False,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+    value = probe.stdout.strip().casefold()
+    return value if probe.returncode == 0 and _REVIEW_COMMIT_RE.fullmatch(value) else None
+
+
+def _terminal_review_incomplete(
+    conn: sqlite3.Connection,
+    task_id: str,
+    *,
+    run_id: int,
+    reason: str,
+    reason_code: str,
+) -> bool:
+    cur = conn.execute(
+        "UPDATE tasks SET status = 'blocked', claim_lock = NULL, "
+        "claim_expires = NULL, worker_pid = NULL, block_kind = 'dependency' "
+        "WHERE id = ? AND status = 'running' AND current_run_id = ?",
+        (task_id, int(run_id)),
+    )
+    if cur.rowcount != 1:
+        return False
+    closed_run_id = _end_run(
+        conn,
+        task_id,
+        outcome="review_incomplete",
+        status="blocked",
+        summary=reason,
+        metadata={
+            "review_outcome": "REVIEW-INCOMPLETE",
+            "reason_code": reason_code,
+            "native_review_run_id": int(run_id),
+        },
+    )
+    _append_event(
+        conn,
+        task_id,
+        "standalone_review_incomplete",
+        {
+            "reason_code": reason_code,
+            "source_status": "ready",
+            "retry_allowed": False,
+        },
+        run_id=closed_run_id,
+    )
+    return True
+
+
+def _record_standalone_review_rejection(
+    conn: sqlite3.Connection,
+    task_id: str,
+    *,
+    reason: Optional[str],
+    kind: Optional[str],
+    expected_run_id: Optional[int],
+) -> Optional[bool]:
+    """Terminally record a standalone rejection and enqueue one native handoff.
+
+    ``None`` means this is not the structured standalone-review path. A bool is
+    the final block result. The transaction never creates product work; it only
+    writes the coordinator-owned, identity-bound outbox record.
+    """
+    redacted_reason = str(redact_review_value(reason or "")).strip()
+    if not redacted_reason.startswith(_STANDALONE_REVIEW_CHANGES_PREFIX):
+        return None
+    if expected_run_id is None:
+        return False
+    run_id = int(expected_run_id)
+    with write_txn(conn):
+        task = conn.execute(
+            "SELECT id, title, body, assignee, created_by, workspace_path, "
+            "status, current_run_id, claim_lock FROM tasks WHERE id = ?",
+            (task_id,),
+        ).fetchone()
+        if task is None or task["status"] != "running" or task["current_run_id"] != run_id:
+            return False
+        claim, claim_error = _review_claim_payload(conn, task_id, run_id)
+        if claim_error is not None:
+            return _terminal_review_incomplete(
+                conn, task_id, run_id=run_id, reason=redacted_reason,
+                reason_code="claim_provenance_invalid",
+            )
+        source_status = claim.get("source_status") or "ready"
+        if source_status == "review":
+            return False
+        if source_status != "ready" or kind != "dependency":
+            return _terminal_review_incomplete(
+                conn, task_id, run_id=run_id, reason=redacted_reason,
+                reason_code="standalone_transition_invalid",
+            )
+        run = conn.execute(
+            "SELECT id, task_id, profile, status, outcome, ended_at, claim_lock "
+            "FROM task_runs WHERE id = ?",
+            (run_id,),
+        ).fetchone()
+        newest = conn.execute(
+            "SELECT id FROM task_runs WHERE task_id = ? ORDER BY id DESC LIMIT 1",
+            (task_id,),
+        ).fetchone()
+        packet, packet_error = _review_packet(str(task["body"] or ""))
+        validation_error = packet_error
+        if validation_error is None and (
+            run is None
+            or run["task_id"] != task_id
+            or run["status"] != "running"
+            or run["outcome"] is not None
+            or run["ended_at"] is not None
+            or newest is None
+            or int(newest["id"]) != run_id
+            or run["claim_lock"] != task["claim_lock"]
+            or claim.get("lock") != task["claim_lock"]
+        ):
+            validation_error = "current review run is not authoritative"
+        if validation_error is None and packet is not None:
+            reviewer = _canonical_assignee(str(task["assignee"] or ""))
+            run_profile = _canonical_assignee(str(run["profile"] or ""))
+            creator = _canonical_assignee(str(task["created_by"] or ""))
+            if reviewer != packet["reviewer_profile"] or run_profile != reviewer:
+                validation_error = "reviewer identity does not match the native run"
+            elif not creator or creator == reviewer:
+                validation_error = "standalone review leaf has no independent creator provenance"
+            elif str(task["workspace_path"] or "") != packet["target_worktree"]:
+                validation_error = "target_worktree does not match native workspace"
+            else:
+                validation_error = _review_packet_claim_receipt(
+                    conn, task_id, run_id, packet
+                )
+        graph = _review_graph_snapshot(conn, task_id)
+        if validation_error is None and packet is not None:
+            parent = next(
+                (row for row in graph["parents"] if row["id"] == packet["implementation_task"]),
+                None,
+            )
+            if parent is None or parent["status"] != "done":
+                validation_error = "implementation task is not a completed direct parent"
+            elif any(
+                child["status"] != "todo"
+                or child["started_at"] is not None
+                or child["current_run_id"] is not None
+                for child in graph["children"]
+            ):
+                validation_error = "downstream frontier is not untouched and gated"
+            elif _review_workspace_head(packet["target_worktree"]) != packet["candidate_commit"]:
+                validation_error = "workspace HEAD does not match candidate_commit"
+        if validation_error is not None or packet is None:
+            return _terminal_review_incomplete(
+                conn, task_id, run_id=run_id, reason=redacted_reason,
+                reason_code="native_evidence_invalid",
+            )
+
+        finding = redacted_reason[len(_STANDALONE_REVIEW_CHANGES_PREFIX):].strip()
+        if not finding:
+            return _terminal_review_incomplete(
+                conn, task_id, run_id=run_id, reason=redacted_reason,
+                reason_code="finding_missing",
+            )
+        packet_json = _review_json(packet)
+        graph_json = _review_json(graph)
+        packet_sha = _review_sha256(packet_json)
+        finding_sha = _review_sha256(finding)
+        frontier_sha = _review_sha256(graph_json)
+        handoff_key = (
+            f"review-remediation:v1:{task_id}:{run_id}:"
+            f"{finding_sha[:16]}:{frontier_sha[:16]}"
+        )
+        now = int(time.time())
+        try:
+            conn.execute(
+                "INSERT INTO review_remediation_handoffs ("
+                "handoff_key, leaf_task_id, review_run_id, reviewer_profile, "
+                "implementer_profile, coordinator_profile, implementation_task, candidate_commit, "
+                "packet_sha256, finding_sha256, frontier_sha256, frontier_json, "
+                "reason, status, created_at) "
+                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?)",
+                (
+                    handoff_key, task_id, run_id, packet["reviewer_profile"],
+                    packet["implementer_profile"], creator, packet["implementation_task"],
+                    packet["candidate_commit"], packet_sha, finding_sha,
+                    frontier_sha, graph_json, finding, now,
+                ),
+            )
+        except sqlite3.IntegrityError:
+            existing = conn.execute(
+                "SELECT handoff_key, packet_sha256, finding_sha256, frontier_sha256 "
+                "FROM review_remediation_handoffs "
+                "WHERE leaf_task_id = ? AND review_run_id = ?",
+                (task_id, run_id),
+            ).fetchone()
+            if (
+                existing is None
+                or existing["handoff_key"] != handoff_key
+                or existing["packet_sha256"] != packet_sha
+                or existing["finding_sha256"] != finding_sha
+                or existing["frontier_sha256"] != frontier_sha
+            ):
+                return _terminal_review_incomplete(
+                    conn, task_id, run_id=run_id, reason=redacted_reason,
+                    reason_code="handoff_identity_collision",
+                )
+        cur = conn.execute(
+            "UPDATE tasks SET status = 'blocked', claim_lock = NULL, "
+            "claim_expires = NULL, worker_pid = NULL, block_kind = 'dependency' "
+            "WHERE id = ? AND status = 'running' AND current_run_id = ?",
+            (task_id, run_id),
+        )
+        if cur.rowcount != 1:
+            return False
+        closed_run_id = _end_run(
+            conn,
+            task_id,
+            outcome="changes_requested",
+            status="blocked",
+            summary=redacted_reason,
+            metadata={
+                "review_outcome": "CHANGES_REQUESTED",
+                "handoff_key": handoff_key,
+                "candidate_commit": packet["candidate_commit"],
+                "packet_sha256": packet_sha,
+                "finding_sha256": finding_sha,
+                "frontier_sha256": frontier_sha,
+                "native_review_run_id": run_id,
+            },
+        )
+        _append_event(
+            conn,
+            task_id,
+            "standalone_review_changes_requested",
+            {
+                "handoff_key": handoff_key,
+                "candidate_commit": packet["candidate_commit"],
+                "packet_sha256": packet_sha,
+                "finding_sha256": finding_sha,
+                "frontier_sha256": frontier_sha,
+                "source_status": "ready",
+                "successor_created": False,
+                "retry_allowed": False,
+            },
+            run_id=closed_run_id,
+        )
+        return True
+
+
+def _handoff_successor_body(
+    *,
+    leaf: sqlite3.Row,
+    handoff: sqlite3.Row,
+    packet: Mapping[str, str],
+) -> str:
+    return "\n".join(
+        [
+            "review_remediation: true",
+            "review_required_before_completion: true",
+            f"review_remediation_handoff_key: {handoff['handoff_key']}",
+            f"standalone_review_leaf: {handoff['leaf_task_id']}",
+            f"standalone_review_run: {handoff['review_run_id']}",
+            f"implementation_task: {handoff['implementation_task']}",
+            f"target_repository: {packet['target_repository']}",
+            f"target_worktree: {packet['target_worktree']}",
+            f"branch: {packet.get('branch') or 'not declared'}",
+            f"reviewed_candidate_commit: {handoff['candidate_commit']}",
+            f"implementer_profile: {handoff['implementer_profile']}",
+            f"reviewer_profile: {handoff['reviewer_profile']}",
+            f"finding_sha256: {handoff['finding_sha256']}",
+            "",
+            "Remediate the independently reviewed finding below in the existing target worktree.",
+            "Before completion, request a same-card review and provide exact candidate_commit evidence.",
+            "The task cannot complete from an implementation run; native policy requires an APPROVED review run.",
+            "",
+            "Reviewer finding:",
+            str(handoff["reason"]),
+        ]
+    )
