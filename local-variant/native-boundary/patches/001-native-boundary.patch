+def _active_worker_run_rejection(
+    conn: sqlite3.Connection,
+    task_id: str,
+    expected_run_id: Any,
+) -> Optional[str]:
+    expected = _exact_positive_run_id(expected_run_id)
+    if expected is None:
+        return "an exact positive built-in expected_run_id is required"
+    task = conn.execute(
+        "SELECT status, assignee, current_run_id, claim_lock, claim_expires "
+        "FROM tasks WHERE id = ?",
+        (task_id,),
+    ).fetchone()
+    if task is None or task["status"] != "running":
+        return "task is not in an active worker run"
+    current = _exact_positive_run_id(task["current_run_id"])
+    if current != expected:
+        return "run_id mismatch"
+    run = conn.execute(
+        "SELECT profile, status, outcome, ended_at, claim_lock, claim_expires "
+        "FROM task_runs WHERE id = ? AND task_id = ?",
+        (expected, task_id),
+    ).fetchone()
+    active_profile = _active_native_profile()
+    task_profile = _canonical_assignee(str(task["assignee"] or ""))
+    now = int(time.time())
+    task_expiry = _exact_positive_run_id(task["claim_expires"])
+    run_expiry = _exact_positive_run_id(run["claim_expires"]) if run is not None else None
+    task_lock = str(task["claim_lock"] or "").strip()
+    if (
+        run is None
+        or not task_lock
+        or task_expiry is None
+        or run_expiry is None
+        or task_expiry <= now
+        or run_expiry <= now
+        or run["status"] != "running"
+        or run["outcome"] is not None
+        or run["ended_at"] is not None
+        or run["claim_lock"] != task["claim_lock"]
+        or run["claim_expires"] != task["claim_expires"]
+        or _canonical_assignee(str(run["profile"] or "")) != task_profile
+        or active_profile != task_profile
+    ):
+        return "active worker identity or lease provenance is invalid"
+    return None
+
