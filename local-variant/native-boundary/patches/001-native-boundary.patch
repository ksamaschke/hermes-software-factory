+def _active_native_profile() -> Optional[str]:
+    try:
+        from hermes_cli.profiles import get_active_profile_name
+        from hermes_constants import get_hermes_home
+
+        value = get_active_profile_name()
+        profile_home = Path(get_hermes_home()).expanduser().resolve(strict=True)
+        user_home = Path.home().resolve(strict=True)
+    except Exception:
+        return None
+    profile = _canonical_assignee(value)
+    if not profile:
+        return None
+    default_home = user_home / ".hermes"
+    expected_home = user_home / ".hermes" / "profiles" / profile
+    if profile == "default" and profile_home == default_home:
+        return profile
+    if profile_home != expected_home or not profile_home.is_dir():
+        return None
+    return profile
