+@contextlib.contextmanager
+def _review_native_mutation_authorized(
+    conn: Optional[sqlite3.Connection] = None,
+):
+    """Authorize one native mutation transaction without a global bypass.
+
+    The durable authorization row is written and removed in the same SQLite
+    transaction, so no concurrent connection can observe it.  Passing ``conn``
+    is reserved for tightly bounded direct-SQL recovery/tests; ordinary native
+    helpers set the context and let :func:`write_txn` install the row.
+    """
+    token = _REVIEW_NATIVE_MUTATION_AUTH.set(True)
+    started = False
+    inserted = False
+    try:
+        if conn is not None:
+            if not conn.in_transaction:
+                _execute_boundary_with_retry(conn, "BEGIN IMMEDIATE")
+                started = True
+            cur = conn.execute(
+                "INSERT OR IGNORE INTO review_native_mutation_authorization(token) VALUES (1)"
+            )
+            inserted = bool(cur.rowcount)
+        yield
+        if conn is not None and inserted:
+            conn.execute(
+                "DELETE FROM review_native_mutation_authorization WHERE token = 1"
+            )
+        if conn is not None and started:
+            _execute_boundary_with_retry(conn, "COMMIT")
+    except Exception:
+        if conn is not None and started and conn.in_transaction:
+            try:
+                conn.execute("ROLLBACK")
+            except sqlite3.OperationalError:
+                pass
+        raise
+    finally:
+        _REVIEW_NATIVE_MUTATION_AUTH.reset(token)
