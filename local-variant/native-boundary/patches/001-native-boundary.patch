+def _validated_remediation_successor(
+    conn: sqlite3.Connection,
+    task_id: str,
+    task: sqlite3.Row,
+) -> tuple[Optional[sqlite3.Row], Optional[dict[str, str]], Optional[str]]:
+    body = str(task["body"] or "")
+    body_key = _review_body_field(body, "review_remediation_handoff_key")
+    task_key = str(task["idempotency_key"] or "")
+    keyed_task = task_key.startswith("review-remediation:v2:")
+    if body_key is not None and keyed_task and body_key != task_key:
+        return None, None, "remediation successor handoff keys disagree"
+    declared_key = body_key or (task_key if keyed_task else None)
+    pointer_rows = conn.execute(
+        "SELECT * FROM review_remediation_handoffs "
+        "WHERE successor_task_id = ? ORDER BY created_at, handoff_key",
+        (task_id,),
+    ).fetchall()
+    if declared_key is not None:
+        key_rows = conn.execute(
+            "SELECT * FROM review_remediation_handoffs WHERE handoff_key = ?",
+            (declared_key,),
+        ).fetchall()
+        if len(key_rows) != 1:
+            return None, None, "remediation successor lost its durable receipt"
+        handoff = key_rows[0]
+        if (
+            handoff["successor_task_id"] != task_id
+            or len(pointer_rows) != 1
+            or pointer_rows[0]["handoff_key"] != declared_key
+        ):
+            return None, None, "remediation successor durable pointer changed"
+    else:
+        if not pointer_rows:
+            return None, None, None
+        if len(pointer_rows) != 1:
+            return None, None, "remediation successor has ambiguous durable receipts"
+        handoff = pointer_rows[0]
+    if (
+        handoff["status"] != "applied"
+        or handoff["tombstone_reason"] is not None
+        or handoff["successor_body_sha256"] is None
+    ):
+        return None, None, "remediation successor receipt is not terminally applied"
+    leaf = conn.execute(
+        "SELECT * FROM tasks WHERE id = ?", (handoff["leaf_task_id"],)
+    ).fetchone()
+    if leaf is None or leaf["status"] != "archived":
+        return None, None, "remediation successor lost its archived review leaf"
+    packet, packet_error = _review_packet(str(leaf["body"] or ""))
+    if packet_error is not None or packet is None:
+        return None, None, packet_error or "archived review packet is invalid"
+    expected_body = _handoff_successor_body(leaf=leaf, handoff=handoff, packet=packet)
+    actual_body = str(task["body"] or "")
+    try:
+        frontier = _strict_json_object(str(handoff["frontier_json"] or ""))
+    except ValueError:
+        frontier = None
+    parent_rows = frontier.get("parents") if isinstance(frontier, dict) else None
+    if not isinstance(parent_rows, list) or not all(
+        isinstance(row, dict)
+        and set(row) == {"id", "status"}
+        and isinstance(row.get("id"), str)
+        and isinstance(row.get("status"), str)
+        for row in parent_rows
+    ):
+        return None, None, "remediation successor frontier receipt is malformed"
+    expected_parents = tuple(sorted(str(row["id"]) for row in parent_rows))
+    actual_parents = tuple(
+        str(row["parent_id"])
+        for row in conn.execute(
+            "SELECT parent_id FROM task_links WHERE child_id = ? ORDER BY parent_id",
+            (task_id,),
+        ).fetchall()
+    )
+    if (
+        task["idempotency_key"] != handoff["handoff_key"]
+        or body_key != handoff["handoff_key"]
+        or _review_body_field(actual_body, "review_remediation_contract")
+        != REVIEW_REMEDIATION_CONTRACT_VERSION
+        or _canonical_assignee(str(task["created_by"] or "")) != handoff["coordinator_profile"]
+        or str(task["workspace_path"] or "") != packet["target_worktree"]
+        or actual_body != expected_body
+        or _review_sha256(actual_body) != handoff["successor_body_sha256"]
+        or actual_parents != expected_parents
+    ):
+        return None, None, "remediation successor durable identity changed"
+    return handoff, packet, None
