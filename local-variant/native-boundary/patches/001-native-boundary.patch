+def _row_value(row: Any, key: str, default: Any = None) -> Any:
+    """Read a sqlite row or mapping without requiring a particular row class."""
+    try:
+        keys = row.keys()
+    except AttributeError:
+        return default
+    return row[key] if key in keys else default
