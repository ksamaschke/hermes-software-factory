+def _review_packet_claim_receipt(
+    conn: sqlite3.Connection,
+    task_id: str,
+    run_id: int,
+    packet: Mapping[str, str],
+) -> Optional[str]:
+    rows = conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND run_id = ? "
+        "AND kind = 'standalone_review_packet_claimed' ORDER BY id",
+        (task_id, run_id),
+    ).fetchall()
+    if len(rows) != 1 or not rows[0]["payload"]:
+        return "standalone review run has no unique packet claim receipt"
+    expected_keys = frozenset(
+        {
+            "contract_version",
+            "task_id",
+            "run_id",
+            "claim_lock",
+            "claim_expires",
+            "source_status",
+            "packet_sha256",
+            "task_title_sha256",
+            "task_body_sha256",
+            "graph_snapshot_sha256",
+            "graph_snapshot",
+            "workspace_identity_sha256",
+            "workspace_identity",
+            "base_commit",
+            "candidate_commit",
+            "scope_manifest_sha256",
+            "implementer_profile",
+            "reviewer_profile",
+            "coordinator_profile",
+        }
+    )
+    payload = _strict_review_payload(rows[0]["payload"], expected_keys)
+    if payload is None:
+        return "standalone review packet claim receipt is malformed"
+    live_identity, identity_error = _review_workspace_identity(packet)
+    if identity_error is not None or live_identity is None:
+        return identity_error or "standalone review workspace identity is unavailable"
+    expected_packet_sha = _review_sha256(_review_json(dict(packet)))
+    expected_identity_sha = _review_sha256(_review_json(live_identity))
+    task = conn.execute(
+        "SELECT title, body, created_by FROM tasks WHERE id = ?",
+        (task_id,),
+    ).fetchone()
+    coordinator = (
+        _canonical_assignee(str(task["created_by"] or "")) if task is not None else None
+    )
+    live_graph = _review_graph_snapshot(conn, task_id)
+    live_graph_json = _review_json(live_graph)
+    if (
+        payload.get("contract_version") != REVIEW_REMEDIATION_CONTRACT_VERSION
+        or payload.get("task_id") != task_id
+        or _exact_positive_run_id(payload.get("run_id")) != run_id
+        or type(payload.get("claim_lock")) is not str
+        or not payload["claim_lock"].strip()
+        or type(payload.get("claim_expires")) is not int
+        or payload["claim_expires"] <= 0
+        or payload.get("source_status") != "ready"
+        or payload.get("packet_sha256") != expected_packet_sha
+        or task is None
+        or payload.get("task_title_sha256") != _review_sha256(str(task["title"] or ""))
+        or payload.get("task_body_sha256") != _review_sha256(str(task["body"] or ""))
+        or payload.get("graph_snapshot_sha256") != _review_sha256(live_graph_json)
+        or payload.get("graph_snapshot") != live_graph
+        or payload.get("workspace_identity_sha256") != expected_identity_sha
+        or payload.get("workspace_identity") != live_identity
+        or payload.get("base_commit") != packet["base_commit"]
+        or payload.get("candidate_commit") != packet["candidate_commit"]
+        or payload.get("scope_manifest_sha256") != packet["scope_manifest_sha256"]
+        or payload.get("implementer_profile") != packet["implementer_profile"]
+        or payload.get("reviewer_profile") != packet["reviewer_profile"]
+        or payload.get("coordinator_profile") != coordinator
+    ):
+        return "standalone review packet changed after claim"
+    return None
+
+
+def _same_card_review_claim_rejection(
+    conn: sqlite3.Connection,
+    task_id: str,
+    run_id: int,
+) -> tuple[bool, Optional[str]]:
+    rows = conn.execute(
+        "SELECT payload FROM task_events WHERE task_id = ? AND run_id = ? "
+        "AND kind = 'same_card_review_claimed' ORDER BY id",
+        (task_id, run_id),
+    ).fetchall()
+    if not rows:
+        return False, None
+    if len(rows) != 1:
+        return True, "same-card review claim receipt is not unique"
+    expected_keys = frozenset(
+        {
+            "contract_version",
+            "task_id",
+            "run_id",
+            "claim_lock",
+            "claim_expires",
+            "source_status",
+            "reviewer_profile",
+            "task_title_sha256",
+            "task_body_sha256",
+            "graph_snapshot_sha256",
+            "graph_snapshot",
+        }
+    )
+    payload = _strict_review_payload(rows[0]["payload"], expected_keys)
+    if payload is None:
+        return True, "same-card review claim receipt is malformed"
+    task = conn.execute(
+        "SELECT title, body, assignee, current_run_id, claim_lock, claim_expires "
+        "FROM tasks WHERE id = ?",
+        (task_id,),
+    ).fetchone()
+    graph = _review_graph_snapshot(conn, task_id)
+    graph_json = _review_json(graph)
+    if (
+        task is None
+        or payload.get("contract_version") != REVIEW_REMEDIATION_CONTRACT_VERSION
+        or payload.get("task_id") != task_id
+        or _exact_positive_run_id(payload.get("run_id")) != run_id
+        or _exact_positive_run_id(task["current_run_id"]) != run_id
+        or type(payload.get("claim_lock")) is not str
+        or not payload["claim_lock"].strip()
+        or payload.get("claim_lock") != task["claim_lock"]
+        or type(payload.get("claim_expires")) is not int
+        or payload["claim_expires"] <= 0
+        or payload.get("source_status") != "review"
+        or payload.get("reviewer_profile")
+        != _canonical_assignee(str(task["assignee"] or ""))
+        or payload.get("task_title_sha256")
+        != _review_sha256(str(task["title"] or ""))
+        or payload.get("task_body_sha256")
+        != _review_sha256(str(task["body"] or ""))
+        or payload.get("graph_snapshot_sha256") != _review_sha256(graph_json)
+        or payload.get("graph_snapshot") != graph
+    ):
+        return True, "same-card review claim evidence changed after claim"
+    return True, None
+
+
+def _review_graph_snapshot(conn: sqlite3.Connection, leaf_task_id: str) -> dict[str, Any]:
+    parents = [
+        {"id": row["id"], "status": row["status"]}
+        for row in conn.execute(
+            "SELECT t.id, t.status FROM task_links l "
+            "JOIN tasks t ON t.id = l.parent_id "
+            "WHERE l.child_id = ? ORDER BY t.id",
+            (leaf_task_id,),
+        ).fetchall()
+    ]
+    children: list[dict[str, Any]] = []
+    child_rows = conn.execute(
+        "SELECT t.id, t.status, t.started_at, t.current_run_id "
+        "FROM task_links l JOIN tasks t ON t.id = l.child_id "
+        "WHERE l.parent_id = ? ORDER BY t.id",
+        (leaf_task_id,),
+    ).fetchall()
+    for child in child_rows:
+        child_id = str(child["id"])
+        parent_ids = [
+            str(row["parent_id"])
+            for row in conn.execute(
+                "SELECT parent_id FROM task_links WHERE child_id = ? ORDER BY parent_id",
+                (child_id,),
+            ).fetchall()
+        ]
+        children.append(
+            {
+                "id": child_id,
+                "status": child["status"],
+                "started_at": child["started_at"],
+                "current_run_id": child["current_run_id"],
+                "parent_ids": parent_ids,
+            }
+        )
+    return {"parents": parents, "children": children}
+
+
+def _review_workspace_head(workspace_path: str) -> Optional[str]:
+    try:
+        workspace = Path(workspace_path).expanduser().resolve(strict=True)
+    except (OSError, RuntimeError):
+        return None
+    git = Path("/usr/bin/git")
+    if not workspace.is_dir() or not git.is_file():
+        return None
+    try:
+        probe = subprocess.run(
+            [str(git), "-C", str(workspace), "rev-parse", "--verify", "HEAD^{commit}"],
+            env={"PATH": "/usr/bin:/bin", "HOME": str(Path.home())},
+            text=True,
+            capture_output=True,
+            timeout=5,
+            check=False,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+    value = probe.stdout.strip().casefold()
+    return value if probe.returncode == 0 and _REVIEW_COMMIT_RE.fullmatch(value) else None
+
+
+def _terminal_review_incomplete(
+    conn: sqlite3.Connection,
+    task_id: str,
+    *,
+    run_id: int,
+    reason: str,
+    reason_code: str,
+) -> bool:
+    cur = conn.execute(
+        "UPDATE tasks SET status = 'blocked', claim_lock = NULL, "
+        "claim_expires = NULL, worker_pid = NULL, block_kind = 'dependency' "
+        "WHERE id = ? AND status = 'running' AND current_run_id = ?",
+        (task_id, int(run_id)),
+    )
+    if cur.rowcount != 1:
+        return False
+    closed_run_id = _end_run(
+        conn,
+        task_id,
+        outcome="review_incomplete",
+        status="blocked",
+        summary=reason,
+        metadata={
+            "review_outcome": "REVIEW-INCOMPLETE",
+            "reason_code": reason_code,
+            "native_review_run_id": int(run_id),
+        },
+    )
+    _append_event(
+        conn,
+        task_id,
+        "standalone_review_incomplete",
+        {
+            "reason_code": reason_code,
+            "source_status": "ready",
+            "retry_allowed": False,
+        },
+        run_id=closed_run_id,
+    )
+    return True
+
+
+def _record_standalone_review_rejection(
+    conn: sqlite3.Connection,
+    task_id: str,
+    *,
+    reason: Optional[str],
+    kind: Optional[str],
+    expected_run_id: Optional[int],
+) -> Optional[bool]:
+    """Terminally record a standalone rejection and enqueue one native handoff.
+
+    ``None`` means this is not the structured standalone-review path. A bool is
+    the final block result. The transaction never creates product work; it only
+    writes the coordinator-owned, identity-bound outbox record.
+    """
+    redacted_reason = str(redact_review_value(reason or "")).strip()
+    if not redacted_reason.startswith(_STANDALONE_REVIEW_CHANGES_PREFIX):
+        return None
+    run_id = _exact_positive_run_id(expected_run_id)
+    if run_id is None:
+        return False
+    with _review_native_mutation_authorized(), write_txn(conn):
+        if _active_worker_run_rejection(conn, task_id, run_id) is not None:
+            return False
+        task = conn.execute(
+            "SELECT id, title, body, assignee, created_by, workspace_path, "
+            "status, current_run_id, claim_lock, claim_expires FROM tasks WHERE id = ?",
+            (task_id,),
+        ).fetchone()
+        if task is None or task["status"] != "running" or task["current_run_id"] != run_id:
+            return False
+        claim, claim_error = _review_claim_payload(conn, task_id, run_id)
+        if claim_error is not None:
+            return _terminal_review_incomplete(
+                conn, task_id, run_id=run_id, reason=redacted_reason,
+                reason_code="claim_provenance_invalid",
+            )
+        source_status = claim.get("source_status") or "ready"
+        if source_status == "review":
+            return False
+        if source_status != "ready" or kind != "dependency":
+            return _terminal_review_incomplete(
+                conn, task_id, run_id=run_id, reason=redacted_reason,
+                reason_code="standalone_transition_invalid",
+            )
+        run = conn.execute(
+            "SELECT id, task_id, profile, status, outcome, ended_at, "
+            "claim_lock, claim_expires FROM task_runs WHERE id = ?",
+            (run_id,),
+        ).fetchone()
+        newest = conn.execute(
+            "SELECT id FROM task_runs WHERE task_id = ? ORDER BY id DESC LIMIT 1",
+            (task_id,),
+        ).fetchone()
+        packet, packet_error = _review_packet(str(task["body"] or ""))
+        validation_error = packet_error
+        if validation_error is None and (
+            run is None
+            or run["task_id"] != task_id
+            or run["status"] != "running"
+            or run["outcome"] is not None
+            or run["ended_at"] is not None
+            or newest is None
+            or _exact_positive_run_id(newest["id"]) != run_id
+            or run["claim_lock"] != task["claim_lock"]
+            or run["claim_expires"] != task["claim_expires"]
+            or _exact_positive_run_id(task["claim_expires"]) is None
+            or task["claim_expires"] <= int(time.time())
+            or claim.get("lock") != task["claim_lock"]
+        ):
+            validation_error = "current review run is not authoritative"
+        if validation_error is None and packet is not None:
+            reviewer = _canonical_assignee(str(task["assignee"] or ""))
+            run_profile = _canonical_assignee(str(run["profile"] or ""))
+            creator = _canonical_assignee(str(task["created_by"] or ""))
+            if reviewer != packet["reviewer_profile"] or run_profile != reviewer:
+                validation_error = "reviewer identity does not match the native run"
+            elif not creator or creator in {
+                reviewer,
+                packet["implementer_profile"],
+            }:
+                validation_error = "standalone review role separation is invalid"
+            elif str(task["workspace_path"] or "") != packet["target_worktree"]:
+                validation_error = "target_worktree does not match native workspace"
+            else:
+                validation_error = _review_packet_claim_receipt(
+                    conn, task_id, run_id, packet
+                )
+        graph = _review_graph_snapshot(conn, task_id)
+        workspace_identity: Optional[dict[str, Any]] = None
+        if validation_error is None and packet is not None:
+            parent = next(
+                (row for row in graph["parents"] if row["id"] == packet["implementation_task"]),
+                None,
+            )
+            if parent is None or parent["status"] != "done":
+                validation_error = "implementation task is not a completed direct parent"
+            elif any(
+                parent_row["status"] not in {"done", "archived"}
+                for parent_row in graph["parents"]
+            ):
+                validation_error = "direct parent frontier is not terminal"
+            elif any(
+                child["status"] != "todo"
+                or child["started_at"] is not None
+                or child["current_run_id"] is not None
+                for child in graph["children"]
+            ):
+                validation_error = "downstream frontier is not untouched and gated"
+            else:
+                workspace_identity, validation_error = _review_workspace_identity(packet)
+        if validation_error is not None or packet is None or workspace_identity is None:
+            return _terminal_review_incomplete(
+                conn, task_id, run_id=run_id, reason=redacted_reason,
+                reason_code="native_evidence_invalid",
+            )
+
+        finding = redacted_reason[len(_STANDALONE_REVIEW_CHANGES_PREFIX):].strip()
+        if not finding:
+            return _terminal_review_incomplete(
+                conn, task_id, run_id=run_id, reason=redacted_reason,
+                reason_code="finding_missing",
+            )
+        packet_json = _review_json(packet)
+        graph_json = _review_json(graph)
+        packet_sha = _review_sha256(packet_json)
+        finding_sha = _review_sha256(finding)
+        frontier_sha = _review_sha256(graph_json)
+        handoff_key = (
+            f"review-remediation:v2:{task_id}:{run_id}:"
+            f"{packet_sha}:{finding_sha}:{frontier_sha}"
+        )
+        workspace_identity_json = _review_json(workspace_identity)
+        now = int(time.time())
+        try:
+            conn.execute(
+                "INSERT INTO review_remediation_handoffs ("
+                "handoff_key, leaf_task_id, review_run_id, reviewer_profile, "
+                "implementer_profile, coordinator_profile, implementation_task, candidate_commit, "
+                "workspace_identity_json, packet_sha256, finding_sha256, frontier_sha256, frontier_json, "
+                "reason, status, created_at) "
+                "VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending', ?)",
+                (
+                    handoff_key, task_id, run_id, packet["reviewer_profile"],
+                    packet["implementer_profile"], creator, packet["implementation_task"],
+                    packet["candidate_commit"], workspace_identity_json, packet_sha, finding_sha,
+                    frontier_sha, graph_json, finding, now,
+                ),
+            )
+        except sqlite3.IntegrityError:
+            existing = conn.execute(
+                "SELECT handoff_key, workspace_identity_json, packet_sha256, "
+                "finding_sha256, frontier_sha256 "
+                "FROM review_remediation_handoffs "
+                "WHERE leaf_task_id = ? AND review_run_id = ?",
+                (task_id, run_id),
+            ).fetchone()
+            if (
+                existing is None
+                or existing["handoff_key"] != handoff_key
+                or existing["workspace_identity_json"] != workspace_identity_json
+                or existing["packet_sha256"] != packet_sha
+                or existing["finding_sha256"] != finding_sha
+                or existing["frontier_sha256"] != frontier_sha
+            ):
+                return _terminal_review_incomplete(
+                    conn, task_id, run_id=run_id, reason=redacted_reason,
+                    reason_code="handoff_identity_collision",
+                )
+        cur = conn.execute(
+            "UPDATE tasks SET status = 'blocked', claim_lock = NULL, "
+            "claim_expires = NULL, worker_pid = NULL, block_kind = 'dependency' "
+            "WHERE id = ? AND status = 'running' AND current_run_id = ? "
+            "AND claim_lock = ? AND claim_expires = ? AND claim_expires > ?",
+            (
+                task_id,
+                run_id,
+                task["claim_lock"],
+                task["claim_expires"],
+                now,
+            ),
+        )
+        if cur.rowcount != 1:
+            return False
+        closed_run_id = _end_run(
+            conn,
+            task_id,
+            outcome="changes_requested",
+            status="blocked",
+            summary=redacted_reason,
+            metadata={
+                "review_outcome": "CHANGES_REQUESTED",
+                "handoff_key": handoff_key,
+                "candidate_commit": packet["candidate_commit"],
+                "packet_sha256": packet_sha,
+                "finding_sha256": finding_sha,
+                "frontier_sha256": frontier_sha,
+                "workspace_identity_sha256": _review_sha256(workspace_identity_json),
+                "contract_version": REVIEW_REMEDIATION_CONTRACT_VERSION,
+                "native_review_run_id": run_id,
+            },
+        )
+        _append_event(
+            conn,
+            task_id,
+            "standalone_review_changes_requested",
+            {
+                "handoff_key": handoff_key,
+                "candidate_commit": packet["candidate_commit"],
+                "packet_sha256": packet_sha,
+                "finding_sha256": finding_sha,
+                "frontier_sha256": frontier_sha,
+                "workspace_identity_sha256": _review_sha256(workspace_identity_json),
+                "contract_version": REVIEW_REMEDIATION_CONTRACT_VERSION,
+                "source_status": "ready",
+                "successor_created": False,
+                "retry_allowed": False,
+            },
+            run_id=closed_run_id,
+        )
+        return True
+
+
+def _handoff_successor_body(
+    *,
+    leaf: sqlite3.Row,
+    handoff: sqlite3.Row,
+    packet: Mapping[str, str],
+) -> str:
+    return "\n".join(
+        [
+            "review_remediation: true",
+            "review_required_before_completion: true",
+            f"review_remediation_handoff_key: {handoff['handoff_key']}",
+            f"review_remediation_contract: {REVIEW_REMEDIATION_CONTRACT_VERSION}",
+            f"standalone_review_leaf: {handoff['leaf_task_id']}",
+            f"standalone_review_run: {handoff['review_run_id']}",
+            f"implementation_task: {handoff['implementation_task']}",
+            f"target_repository: {packet['target_repository']}",
+            f"target_worktree: {packet['target_worktree']}",
+            f"branch: {packet['branch']}",
+            f"base_commit: {packet['base_commit']}",
+            f"scope_manifest_sha256: {packet['scope_manifest_sha256']}",
+            f"reviewed_candidate_commit: {handoff['candidate_commit']}",
+            f"implementer_profile: {handoff['implementer_profile']}",
+            f"reviewer_profile: {handoff['reviewer_profile']}",
+            f"finding_sha256: {handoff['finding_sha256']}",
+            "",
+            "Remediate the independently reviewed finding below in the existing target worktree.",
+            "Before completion, request a same-card review and provide exact candidate_commit evidence.",
+            "The task cannot complete from an implementation run; native policy requires an APPROVED review run.",
+            "",
+            "Reviewer finding:",
+            str(handoff["reason"]),
+        ]
+    )
+
+
+def _existing_handoff_successor(
+    conn: sqlite3.Connection, handoff_key: str
+) -> Optional[sqlite3.Row]:
+    rows = conn.execute(
+        "SELECT * FROM tasks WHERE idempotency_key = ? ORDER BY created_at, id",
+        (handoff_key,),
+    ).fetchall()
+    if len(rows) > 1:
+        raise RuntimeError(f"multiple remediation tasks share {handoff_key}")
+    return rows[0] if rows else None
+
+
+def consume_standalone_review_handoffs(
+    conn: sqlite3.Connection,
+    *,
+    limit: int = 16,
+    handoff_key: Optional[str] = None,
+) -> list[dict[str, Any]]:
+    """Consume coordinator-owned review receipts under native SQLite fencing.
+
+    The mutating actor is resolved from the active Hermes profile; callers
+    cannot provide or spoof an actor string. Each handoff is validated,
+    created/reused, reparented, archived, and marked applied in one
+    ``BEGIN IMMEDIATE`` transaction.
+    """
+    canonical_actor = _active_native_profile()
+    if not canonical_actor:
+        raise PermissionError("standalone review remediation requires an active native profile")
+    bounded_limit = max(1, min(int(limit), 100))
+    if handoff_key is not None:
+        if type(handoff_key) is not str or not handoff_key.startswith("review-remediation:v2:"):
+            raise ValueError("handoff_key must be an exact native remediation key")
+        keys = [handoff_key] if conn.execute(
+            "SELECT 1 FROM review_remediation_handoffs "
+            "WHERE handoff_key = ? AND status = 'pending' AND coordinator_profile = ?",
+            (handoff_key, canonical_actor),
+        ).fetchone() is not None else []
+    else:
+        keys = [
+            str(row["handoff_key"])
+            for row in conn.execute(
+                "SELECT handoff_key FROM review_remediation_handoffs "
+                "WHERE status = 'pending' AND coordinator_profile = ? "
+                "ORDER BY created_at, handoff_key LIMIT ?",
+                (canonical_actor, bounded_limit),
+            ).fetchall()
+        ]
+    results: list[dict[str, Any]] = []
+    for handoff_key in keys:
+        with _review_native_mutation_authorized(), write_txn(conn):
+            handoff = conn.execute(
+                "SELECT * FROM review_remediation_handoffs WHERE handoff_key = ?",
+                (handoff_key,),
+            ).fetchone()
+            if handoff is None:
+                continue
+            if handoff["coordinator_profile"] != canonical_actor:
+                raise PermissionError(f"handoff {handoff_key} belongs to another coordinator")
+            if handoff["status"] == "applied":
+                successor = _existing_handoff_successor(conn, handoff_key)
+                if successor is None or successor["id"] != handoff["successor_task_id"]:
+                    raise RuntimeError(f"applied handoff {handoff_key} lost its successor")
+                results.append(
+                    {"handoff_key": handoff_key, "successor_task_id": successor["id"], "reused": True}
+                )
+                continue
+            leaf = conn.execute(
+                "SELECT * FROM tasks WHERE id = ?",
+                (handoff["leaf_task_id"],),
+            ).fetchone()
+            if leaf is None or leaf["status"] != "blocked" or leaf["current_run_id"] is not None:
+                raise RuntimeError(f"handoff {handoff_key} leaf is no longer terminally blocked")
+            packet, packet_error = _review_packet(str(leaf["body"] or ""))
+            if packet_error is not None or packet is None:
+                raise RuntimeError(f"handoff {handoff_key} packet changed: {packet_error}")
+            receipt_error = _review_packet_claim_receipt(
+                conn, str(leaf["id"]), int(handoff["review_run_id"]), packet
+            )
+            if receipt_error is not None:
+                raise RuntimeError(f"handoff {handoff_key} packet receipt changed: {receipt_error}")
+            workspace_identity, workspace_error = _review_workspace_identity(packet)
+            if workspace_error is not None or workspace_identity is None:
+                raise RuntimeError(
+                    f"handoff {handoff_key} workspace identity changed: {workspace_error}"
+                )
+            workspace_identity_json = _review_json(workspace_identity)
+            packet_sha = _review_sha256(_review_json(packet))
+            graph = _review_graph_snapshot(conn, str(leaf["id"]))
+            graph_json = _review_json(graph)
+            if (
+                packet_sha != handoff["packet_sha256"]
+                or workspace_identity_json != handoff["workspace_identity_json"]
+                or _review_sha256(graph_json) != handoff["frontier_sha256"]
+                or graph_json != handoff["frontier_json"]
+                or packet["candidate_commit"] != handoff["candidate_commit"]
+                or packet["reviewer_profile"] != handoff["reviewer_profile"]
+                or packet["implementer_profile"] != handoff["implementer_profile"]
+                or packet["implementation_task"] != handoff["implementation_task"]
+                or _canonical_assignee(str(leaf["created_by"] or "")) != handoff["coordinator_profile"]
+                or _review_sha256(str(handoff["reason"])) != handoff["finding_sha256"]
+            ):
