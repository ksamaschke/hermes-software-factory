+def _review_task_protection_reason(
+    conn: sqlite3.Connection,
+    task_id: str,
+) -> Optional[str]:
+    task = conn.execute(
+        "SELECT idempotency_key, current_run_id FROM tasks WHERE id = ?", (task_id,)
+    ).fetchone()
+    if task is None:
+        return None
+    if str(task["idempotency_key"] or "").startswith("review-remediation:v2:"):
+        return "native review remediation successor"
+    handoff = conn.execute(
+        "SELECT status FROM review_remediation_handoffs "
+        "WHERE leaf_task_id = ? OR successor_task_id = ? LIMIT 1",
+        (task_id, task_id),
+    ).fetchone()
+    if handoff is not None:
+        return f"native review remediation receipt ({handoff['status']})"
+    event = conn.execute(
+        "SELECT kind FROM task_events WHERE task_id = ? AND (kind IN ("
+        "'standalone_review_packet_claimed', "
+        "'standalone_review_changes_requested', "
+        "'standalone_review_incomplete', "
+        "'standalone_review_approved', "
+        "'standalone_review_handoff_tombstoned', "
+        "'same_card_review_approved') "
+        "OR (kind = 'same_card_review_claimed' AND run_id = ?)) "
+        "ORDER BY id DESC LIMIT 1",
+        (task_id, task["current_run_id"]),
+    ).fetchone()
+    if event is not None:
+        return f"native review evidence ({event['kind']})"
+    return None
+
