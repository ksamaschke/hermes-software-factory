--- /dev/null
+++ b/hermes_cli/review_metadata_boundary.py
@@ -0,0 +1,188 @@
+"""Strict, shared metadata boundary for native Kanban reviews.
+
+The public tool handlers, dashboard-backed native entry points, and direct
+Python callers must observe one exact contract.  This module is deliberately
+small and dependency-free so both ``tools.kanban_tools`` and
+``hermes_cli.kanban_db`` can validate before serialization or durable lookup.
+"""
+
+from __future__ import annotations
+
+import math
+import re
+from typing import Any
+
+_REVIEW_COMMIT_RE = re.compile(r"[0-9a-f]{40}")
+_REVIEW_SHA256_RE = re.compile(r"[0-9a-f]{64}")
+_PROTECTED_FIELDS = (
+    "candidate_commit",
+    "pr_head_sha",
+    "post_verification_head",
+    "review_outcome",
+    "review_remediation_handoff_key",
+    "scope_manifest_sha256",
+)
+_REMEDIATION_FIELDS = (
+    "review_remediation_handoff_key",
+    "scope_manifest_sha256",
+)
+_MAX_NESTING = 32
+
+
+def _snapshot_json_value(
+    value: Any,
+    *,
+    active: set[int],
+    depth: int,
+) -> tuple[Any, str | None]:
+    value_type = type(value)
+    if value is None or value_type in (str, bool):
+        return value, None
+    if value_type is int:
+        if value < -(2**63) or value > 2**63 - 1:
+            return (
+                None,
+                "review metadata integers must fit the signed 64-bit JSON range",
+            )
+        return value, None
+    if value_type is float:
+        if not math.isfinite(value):
+            return None, "review metadata floats must be finite"
+        return value, None
+    if depth >= _MAX_NESTING:
+        return None, "review metadata exceeds the maximum nesting depth"
+    if value_type is list:
+        identity = id(value)
+        if identity in active:
+            return None, "review metadata must be acyclic"
+        active.add(identity)
+        try:
+            try:
+                source = list(value)
+            except (RuntimeError, TypeError):
+                return None, "review metadata changed while being materialized"
+            result = []
+            for item in source:
+                snapshot, error = _snapshot_json_value(
+                    item,
+                    active=active,
+                    depth=depth + 1,
+                )
+                if error is not None:
+                    return None, error
+                result.append(snapshot)
+            return result, None
+        finally:
+            active.remove(identity)
+    if value_type is dict:
+        identity = id(value)
+        if identity in active:
+            return None, "review metadata must be acyclic"
+        active.add(identity)
+        try:
+            try:
+                source = list(value.items())
+            except (RuntimeError, TypeError):
+                return None, "review metadata changed while being materialized"
+            result = {}
+            for key, item in source:
+                if type(key) is not str:
+                    return None, "review metadata keys must use exact built-in strings"
+                snapshot, error = _snapshot_json_value(
+                    item,
+                    active=active,
+                    depth=depth + 1,
+                )
+                if error is not None:
+                    return None, error
+                result[key] = snapshot
+            return result, None
+        finally:
+            active.remove(identity)
+    return None, "review metadata must contain only JSON-safe exact built-in values"
+
+
+def _canonical_hex(value: str, pattern: re.Pattern[str]) -> str | None:
+    canonical = value.strip().casefold()
+    return canonical if pattern.fullmatch(canonical) else None
+
+
+def validate_review_metadata(
+    metadata: Any,
+    *,
+    operation: str,
+) -> tuple[dict[str, Any] | None, str | None]:
+    """Materialize and validate review metadata without coercion.
+
+    ``operation`` is either ``request`` or ``completion``.  The returned dict
+    has no aliases to caller-owned containers and contains only strict JSON
+    primitives.  Protected identities are canonicalized only after exact-type
+    validation; failures never stringify or serialize attacker-controlled
+    objects.
+    """
+
+    if operation not in ("request", "completion"):
+        raise ValueError(f"unsupported review metadata operation: {operation}")
+    if metadata is None:
+        return None, None
+    if type(metadata) is not dict:
+        return None, "review metadata must use exact built-in dict"
+    if any(type(key) is not str for key in metadata):
+        return None, "review metadata keys must use exact built-in strings"
+    for field in _PROTECTED_FIELDS:
+        if field in metadata and type(metadata[field]) is not str:
+            return (
+                None,
+                f"review metadata field {field} must use exact built-in strings",
+            )
+
+    snapshot, error = _snapshot_json_value(metadata, active=set(), depth=0)
+    if error is not None:
+        return None, error
+    assert type(snapshot) is dict
+
+    candidate = None
+    if "candidate_commit" in snapshot:
+        candidate = _canonical_hex(snapshot["candidate_commit"], _REVIEW_COMMIT_RE)
+        if candidate is None:
+            return None, "candidate_commit must be a canonical 40-hex commit"
+        snapshot["candidate_commit"] = candidate
+
+    for alias in ("pr_head_sha", "post_verification_head"):
+        if alias not in snapshot:
+            continue
+        alias_commit = _canonical_hex(snapshot[alias], _REVIEW_COMMIT_RE)
+        if alias_commit is None:
+            return None, f"{alias} must be a canonical 40-hex commit"
+        if candidate is None or alias_commit != candidate:
+            return None, f"{alias} must match candidate_commit"
+        snapshot[alias] = alias_commit
+
+    if "review_outcome" in snapshot:
+        if operation == "request":
+            return None, "review_outcome is valid only for review completion"
+        if snapshot["review_outcome"] != "APPROVED":
+            return None, "review_outcome must be the literal APPROVED"
+        if candidate is None:
+            return None, "review_outcome requires candidate_commit"
+
+    remediation_present = [field in snapshot for field in _REMEDIATION_FIELDS]
+    if any(remediation_present) and not all(remediation_present):
+        return (
+            None,
+            "review remediation handoff key and scope digest must appear together",
+        )
+    if all(remediation_present):
+        if candidate is None:
+            return None, "review remediation metadata requires candidate_commit"
+        if not snapshot["review_remediation_handoff_key"].strip():
+            return None, "review remediation handoff key must not be empty"
+        scope_digest = _canonical_hex(
+            snapshot["scope_manifest_sha256"],
+            _REVIEW_SHA256_RE,
+        )
+        if scope_digest is None:
+            return None, "scope_manifest_sha256 must be a canonical 64-hex digest"
+        snapshot["scope_manifest_sha256"] = scope_digest
+
+    return snapshot, None
