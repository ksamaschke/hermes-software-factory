+def _expected_review_trigger_sql() -> dict[str, str]:
+    expected: dict[str, str] = {}
+    statement = ""
+    for line in SCHEMA_SQL.splitlines(keepends=True):
+        statement += line
+        if not sqlite3.complete_statement(statement):
+            continue
+        match = re.search(
+            r"\bCREATE\s+TRIGGER(?:\s+IF\s+NOT\s+EXISTS)?\s+([A-Za-z0-9_]+)",
+            statement,
+            flags=re.IGNORECASE,
+        )
+        if match and match.group(1) in _REVIEW_PROTECTED_TRIGGER_NAMES:
+            expected[match.group(1)] = _normalise_review_trigger_sql(statement)
+        statement = ""
+    if set(expected) != set(_REVIEW_PROTECTED_TRIGGER_NAMES):
+        missing = sorted(set(_REVIEW_PROTECTED_TRIGGER_NAMES) - set(expected))
+        raise sqlite3.DatabaseError(
+            "protected trigger definitions are missing from SCHEMA_SQL: "
+            + ", ".join(missing)
+        )
+    return expected
+
