+def _review_run_bounded(
+    command: list[str],
+    *,
+    timeout: float,
+) -> subprocess.CompletedProcess:
+    """Run one isolated Git probe with strict byte/time/UTF-8 bounds."""
+    process = subprocess.Popen(
+        command,
+        env=_review_git_env(),
+        stdin=subprocess.DEVNULL,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+    )
