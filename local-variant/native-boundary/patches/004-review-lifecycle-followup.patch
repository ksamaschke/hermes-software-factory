+def _refuse_lossy_review_schema_repair(conn: sqlite3.Connection) -> None:
+    """Refuse to recreate missing native-boundary tables after prior install.
+
+    A genuinely legacy or empty board can receive the additive schema. Once any
+    protected object or native review evidence exists, a missing protected table
+    is evidence loss and must be recovered from a backup instead of silently
+    creating an empty replacement.
+    """
+    rows = conn.execute(
+        "SELECT type, name FROM sqlite_master WHERE type IN ('table', 'trigger')"
+    ).fetchall()
+    tables = {str(row["name"]) for row in rows if row["type"] == "table"}
+    missing = set(_REVIEW_PROTECTED_SCHEMA_TABLES) - tables
+    if not missing:
+        return
+    names = {str(row["name"]) for row in rows}
+    native_tables = {
+        "review_remediation_handoffs",
+        _REVIEW_NATIVE_MUTATION_AUTH_TABLE,
+        _REVIEW_RUN_CAPABILITY_TABLE,
+        _REVIEW_DISPATCH_AUTH_TABLE,
+        _REVIEW_SCHEMA_MIGRATION_TABLE,
+    }
+    existing_native_tables = sorted((native_tables - missing) & tables)
+    prior_boundary = bool(set(_REVIEW_PROTECTED_TRIGGER_NAMES) & names)
+    if not prior_boundary:
+        prior_boundary = any(
+            conn.execute(f"SELECT 1 FROM {table} LIMIT 1").fetchone() is not None
+            for table in existing_native_tables
+        )
+    if not prior_boundary and "task_events" in tables:
+        event_columns = {
+            str(row["name"])
+            for row in conn.execute("PRAGMA table_info(task_events)").fetchall()
+        }
+        if "kind" in event_columns:
+            placeholders = ", ".join("?" for _ in _REVIEW_PROTECTED_EVENT_KINDS)
+            prior_boundary = conn.execute(
+                f"SELECT 1 FROM task_events WHERE kind IN ({placeholders}) LIMIT 1",
+                tuple(sorted(_REVIEW_PROTECTED_EVENT_KINDS)),
+            ).fetchone() is not None
+    if not prior_boundary and "tasks" in tables:
+        task_columns = {
+            str(row["name"])
+            for row in conn.execute("PRAGMA table_info(tasks)").fetchall()
