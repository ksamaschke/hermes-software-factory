+                "SELECT 1 FROM tasks "
+                "WHERE idempotency_key GLOB 'review-remediation:v2:*' LIMIT 1"
+            ).fetchone() is not None
+    if prior_boundary:
+        raise sqlite3.DatabaseError(
+            "refusing lossy repair of missing protected review tables: "
+            + ", ".join(sorted(missing))
+        )
