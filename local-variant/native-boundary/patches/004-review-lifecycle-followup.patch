+def _process_identity_token(pid: Optional[int]) -> Optional[str]:
+    """Return a bounded process-start identity that survives PID reuse checks."""
+    if not pid or pid <= 0:
+        return None
+    try:
+        if sys.platform == "linux":
+            stat_text = Path(f"/proc/{int(pid)}/stat").read_text(
+                encoding="utf-8", errors="strict"
+            )
+            close_paren = stat_text.rfind(")")
+            if close_paren < 0:
+                return None
+            fields = stat_text[close_paren + 2 :].split()
+            if len(fields) <= 19:
+                return None
+            start_ticks = fields[19]
+            boot_id = Path("/proc/sys/kernel/random/boot_id").read_text(
+                encoding="ascii", errors="strict"
+            ).strip()
+            token = f"linux:{boot_id}:{start_ticks}"
+        elif sys.platform == "darwin":
+            proc = subprocess.run(
+                ["ps", "-o", "lstart=", "-p", str(int(pid))],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.DEVNULL,
+                text=True,
+                encoding="utf-8",
+                errors="strict",
+                timeout=1,
+                check=False,
+            )
+            if proc.returncode != 0:
+                return None
+            token = f"darwin:{(proc.stdout or '').strip()}"
+        else:
+            return None
+    except (OSError, UnicodeError, subprocess.SubprocessError, TimeoutError):
+        return None
+    return token[:_PROCESS_IDENTITY_TOKEN_MAX_BYTES] if token else None
