+def _normalise_review_trigger_sql(sql: str) -> str:
+    """Canonicalise SQLite's formatting while preserving trigger semantics."""
+    text = re.sub(r"--[^\n]*", " ", sql)
+    text = re.sub(r"\bIF\s+NOT\s+EXISTS\b", "", text, flags=re.IGNORECASE)
+    return re.sub(r"\s+", " ", text.strip().rstrip(";")).casefold()
+
