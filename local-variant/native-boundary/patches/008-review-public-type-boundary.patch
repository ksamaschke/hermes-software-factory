+def _review_metadata_type_error(metadata: Optional[dict]) -> Optional[str]:
+    if not isinstance(metadata, dict):
+        return None
+    for raw_key, value in metadata.items():
+        if type(raw_key) is not str:
+            return "review metadata keys must use exact built-in strings"
+        if raw_key in _REVIEW_TYPED_STRING_FIELDS and type(value) is not str:
+            return f"review metadata field {raw_key} must use exact built-in strings"
+    return None
