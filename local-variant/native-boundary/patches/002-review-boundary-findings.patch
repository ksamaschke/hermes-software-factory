+            (task_id,),
+        ).fetchone()
+        if (
+            live is None
+            or live["status"] != "running"
+            or live["current_run_id"] != run_id
+            or live["claim_lock"] != claim_lock
+            or live["claim_expires"] != claim_expires
+        ):
+            raise RuntimeError("dispatcher claim changed before post-claim transition")
+        conn.execute(
+            "INSERT INTO review_native_dispatch_authorization "
+            "(task_id, run_id, claim_lock, claim_expires, field, value) "
+            "VALUES (?, ?, ?, ?, ?, ?)",
+            (task_id, run_id, claim_lock, claim_expires, field, str(value)),
+        )
