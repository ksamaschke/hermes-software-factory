+            "task_id": str(task_id),
+            "run_id": run_id,
+            "claim_lock": claim_lock,
+            "claim_expires": claim_expires,
+            "field": field,
+            "value": str(value),
+        }
+    )
+    started = False
+    try:
+        _execute_boundary_with_retry(conn, "BEGIN IMMEDIATE")
+        started = True
