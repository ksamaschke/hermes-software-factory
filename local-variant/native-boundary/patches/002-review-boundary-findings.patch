+def _execute_schema_script_atomically(conn: sqlite3.Connection, script: str) -> None:
+    """Execute a SQLite schema script without implicit transaction breaks."""
+    statement: list[str] = []
+    for line in script.splitlines(keepends=True):
+        statement.append(line)
+        candidate = "".join(statement)
+        if sqlite3.complete_statement(candidate):
+            if candidate.strip():
+                conn.execute(candidate)
+            statement.clear()
+    trailing = "".join(statement).strip()
+    if trailing:
+        conn.execute(trailing)
