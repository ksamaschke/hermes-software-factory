+@contextlib.contextmanager
+def _review_dispatch_transition(
+    conn: sqlite3.Connection,
+    *,
+    task_id: str,
+    run_id: int,
+    claim_lock: str,
+    claim_expires: int,
+    field: str,
+    value: str,
