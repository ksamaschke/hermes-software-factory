+    """Authorize one exact post-claim dispatcher field transition.
+
+    The authorization row is created, consumed, and deleted inside the same
+    transaction as the one allowed task update. It is not the broad native
+    review-mutation bypass: the row names the exact task, run, lease, field,
+    and value that the dispatcher is allowed to persist.
+    """
+    if (
+        type(run_id) is not int
+        or run_id <= 0
+        or type(claim_expires) is not int
+        or claim_expires <= 0
+        or not isinstance(claim_lock, str)
+        or not claim_lock
+        or field not in {"workspace_path", "branch_name", "worker_pid"}
+    ):
+        raise RuntimeError("dispatcher transition requires an exact live claim")
+    if conn.in_transaction:
+        raise RuntimeError("dispatcher transition must own its write transaction")
+    token = _REVIEW_DISPATCH_AUTH.set(
