+def _review_git_callback_overrides(workspace: Path) -> Optional[tuple[str, ...]]:
+    """Enumerate and disable every repository-configured callback key.
+
+    Git's local config is data for this read-only probe, but its filter and
+    diff callback values must never be inherited by a provenance command.
+    The names are discovered without invoking Git operations that consult
+    attributes, then each callback is explicitly blanked on the real probe.
+    ``None`` fails closed if the local config cannot be read.
+    """
+    try:
+        result = subprocess.run(
+            [
+                "/usr/bin/git",
+                "--no-pager",
+                "--no-optional-locks",
+                *_REVIEW_GIT_CONFIG_ARGS,
+                "-C",
+                str(workspace),
+                "config",
+                "--local",
+                "--name-only",
+                "--get-regexp",
+                r"^(filter|diff)\.",
+            ],
+            env=_review_git_env(),
+            text=True,
+            capture_output=True,
+            check=False,
+            timeout=15,
+        )
+    except (OSError, subprocess.TimeoutExpired):
+        return None
+    if result.returncode not in {0, 1}:
+        return None
+    overrides: list[str] = []
+    for raw_key in (result.stdout or "").splitlines():
+        key = raw_key.strip()
+        lower = key.casefold()
+        if re.fullmatch(r"filter\..+\.(clean|smudge|process|driver)", lower):
+            overrides.extend(("-c", f"{key}="))
+        elif re.fullmatch(r"filter\..+\.required", lower):
+            overrides.extend(("-c", f"{key}=false"))
+        elif re.fullmatch(r"diff\..+\.(textconv|command)", lower):
+            overrides.extend(("-c", f"{key}="))
+    return tuple(overrides)
