+def _review_git_worktree_clean(workspace: Path) -> bool:
+    """Check worktree bytes against the index without Git callbacks.
+
+    ``git status`` is deliberately not used: it may invoke any configured
+    ``filter.*.clean`` or ``filter.*.process`` command while normalizing a
+    worktree file.  Git's index is read through plumbing and regular/symlink
+    blob hashes are computed locally, so repository callbacks never run.
+    """
+    try:
+        tracked = _review_git_probe(
+            workspace, "ls-files", "--cached", "--stage", "-z", timeout=15
+        )
+        object_format = _review_git_probe(
+            workspace, "rev-parse", "--show-object-format", timeout=15
+        )
+    except (OSError, subprocess.TimeoutExpired, RuntimeError):
+        return False
+    if tracked.returncode != 0 or object_format.returncode != 0:
+        return False
+    algorithm = (object_format.stdout or "").strip().casefold()
+    if algorithm not in {"sha1", "sha256"}:
+        return False
+    root = workspace.resolve(strict=True)
+    for record in (tracked.stdout or "").split("\x00"):
+        if not record:
+            continue
+        try:
+            header, raw_path = record.split("\t", 1)
+            mode, expected_oid, stage = header.split()
+        except ValueError:
+            return False
+        if stage != "0" or mode == "160000" or not expected_oid:
+            return False
+        path_text = raw_path
+        if (
+            not path_text
+            or path_text.startswith("/")
+            or any(part in {"", ".", ".."} for part in path_text.split("/"))
+        ):
+            return False
+        candidate = workspace.joinpath(*path_text.split("/"))
+        try:
+            if not candidate.parent.resolve(strict=True).is_relative_to(root):
+                return False
+            item_stat = candidate.lstat()
+            if mode == "120000":
+                if not item_stat or not candidate.is_symlink():
+                    return False
+                data = os.fsencode(os.readlink(candidate))
+            elif mode in {"100644", "100755"}:
+                if not stat.S_ISREG(item_stat.st_mode):
+                    return False
+                executable = bool(item_stat.st_mode & 0o111)
+                if executable != (mode == "100755"):
+                    return False
+                data = candidate.read_bytes()
+            else:
+                return False
+        except (OSError, RuntimeError, ValueError):
+            return False
+        digest = hashlib.new(
+            algorithm, f"blob {len(data)}\0".encode("ascii") + data
+        ).hexdigest()
+        if digest.casefold() != expected_oid.casefold():
+            return False
+    try:
+        untracked = _review_git_probe(
+            workspace,
+            "ls-files",
+            "--others",
+            "--exclude-standard",
+            "-z",
+            timeout=15,
+        )
+    except (OSError, subprocess.TimeoutExpired, RuntimeError):
+        return False
+    return untracked.returncode == 0 and not (untracked.stdout or "")

