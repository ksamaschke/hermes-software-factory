+def _legacy_review_requested_payload(payload: Any) -> dict[str, Any] | None:
+    """Validate the pre-native request-review receipt with no reviewer.
+
+    Older callers intentionally left the task assigned to its implementer and
+    used a human/operator review lane.  Keep that receipt recognizable without
+    weakening the strict role-separated native handoff validator above.
+    """
+    value = _json_object(payload)
+    if value is None or frozenset(value) != frozenset(
+        {"summary", "metadata", "implementer", "reviewer"}
+    ):
+        return None
+    summary = value["summary"]
+    if summary is not None and (
+        type(summary) is not str
+        or not summary.strip()
+        or summary != summary.strip()
+        or len(summary) > 400
+    ):
+        return None
+    if value["metadata"] is not None and not isinstance(value["metadata"], dict):
+        return None
+    if value["reviewer"] is not None:
+        return None
+    implementer = _canonical_profile_id(value["implementer"])
+    if implementer is None:
+        return None
+    return value

